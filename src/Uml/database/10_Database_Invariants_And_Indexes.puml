  Order(store_id, number)
  Order(store_id, payment_status)
  Order(store_id, status)
  Order(created_by_id)
  Order(canceled_by_id)
  Order(canceled_at)
  OrderEntry(order_id)
  OrderEntry(product_id)
  OrderEntry(warehouse_stock_batch_id)
  Purchase(store_id, number)
  Purchase(store_id, payment_status)
  Purchase(store_id, status)
  Purchase(created_by_id)
  Purchase(canceled_by_id)
  Purchase(canceled_at)
  PurchaseEntry(purchase_id)
  PurchaseEntry(product_id)
  Payment(store_id, paid_at)
  Payment(order_id)
  Payment(purchase_id)
  Payment(store_id, direction, paid_at)
  Payment(created_by_id)
  Payment(updated_by_id)
  PaymentHistory(store_id, document_type, document_id, occurred_at)
  PaymentHistory(store_id, occurred_at)
  PaymentHistory(payment_id)
  PaymentHistory(order_id)
  PaymentHistory(purchase_id)
  PaymentHistory(actor_id)
  ProductionOrder(store_id, status)
  ProductionOrder(created_by_id)
  ProductionOrder(canceled_by_id)
  ProductionOrder(canceled_at)
  ProductionOrderMaterial(production_order_id)
