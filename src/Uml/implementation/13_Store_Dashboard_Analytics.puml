@startuml
title Store Dashboard Analytics

skinparam packageStyle rectangle

actor "Store admin" as StoreAdmin
actor "Store manager" as StoreManager

package "Admin HTTP" {
  component StoreController
}

package "Dashboard services" {
  component StoreDashboardProvider

  component StoreDashboardQuery
}

package "Rendering" {
  component "store/main.html.twig" as DashboardTwig
  component "dashboard-chart_controller.js" as ChartController
}

database "Shop database" as DB

StoreAdmin --> StoreController : full financial view
StoreManager --> StoreController : operational view
StoreController --> StoreDashboardProvider : date/warehouse filters
StoreDashboardProvider --> StoreDashboardQuery : aggregate read model
StoreDashboardQuery --> DB : read-only aggregate queries
StoreDashboardProvider --> DashboardTwig : dashboard array
DashboardTwig --> ChartController : chart datasets

note bottom of StoreDashboardProvider
  Monetary values are based on persisted base-currency
  document fields. Historical totals are not recalculated
  from current product prices.
end note

note bottom of StoreDashboardQuery
  Query service returns aggregate rows only and avoids
  loading full document collections for dashboard sections.
end note

@enduml
