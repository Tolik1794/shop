@startuml

title Product domain

hide circle
skinparam linetype ortho

entity Store {
    * id: int
    --
    * name: string(255)
    * slug: string(255) <<unique>>
    * phone: string(255)
    * email: string(255)
    description: string(255)?
    avatar: string(255)?
    * status: ActiveStatusEnum
}

entity Category {
    * id: int
    --
    * name: string(255)
    description: string(255)?
    * level: int
    * store: Store
    parent: Category?
    firstParent: Category?
    products: Collection<Product>
    children: Collection<Category>
    categoryProductParameterNames: Collection<CategoryProductParameterName>
}

entity Product {
    * id: int
    --
    * name: string(255)
    * code: string(255)
    * store: Store
    * category: Category
    productParameters: Collection<ProductParameter>
    warehouseProducts: Collection<WarehouseProduct>
}

entity ProductParameterName {
    * id: int
    --
    * name: string(255)
    * description: string(255)
    productParameters: Collection<ProductParameter>
    categoryProductParameterNames: Collection<CategoryProductParameterName>
}

entity ProductParameter {
    * id: int
    --
    * product: Product
    * productParameterName: ProductParameterName
    * value: string(255)
}

entity CategoryProductParameterName {
    * id: int
    --
    * category: Category
    * productParameterName: ProductParameterName
    * isRequired: bool
    * isFilter: bool
}

entity Warehouse {
    * id: int
    --
    * name: string(255)
    * store: Store
    warehouseProducts: Collection<WarehouseProduct>
}

entity WarehouseProduct {
    * id: int
    --
    * warehouse: Warehouse
    * product: Product
    * purchasePrice: decimal(14, 4)
    * minimumSellingPrice: decimal(14, 4)
    * sellingPrice: decimal(14, 4)
    * count: int
    * reserveCount: int
    entries: Collection<Entry>
}

entity Entry {
    * id: int
    --
    * warehouseProduct: WarehouseProduct
    * cost: decimal(14, 4)
    deliveryCost: decimal(10, 4)?
}

Store ||--o{ Category : owns
Store ||--o{ Product : owns
Store ||--o{ Warehouse : owns

Category ||--o{ Product : classifies
Category |o--o{ Category : parent
Category |o--o{ Category : firstParent
Category ||--o{ CategoryProductParameterName : defines

ProductParameterName ||--o{ CategoryProductParameterName : allowed for category
ProductParameterName ||--o{ ProductParameter : names

Product ||--o{ ProductParameter : has
Product ||--o{ WarehouseProduct : stocked as
Warehouse ||--o{ WarehouseProduct : contains
WarehouseProduct ||--o{ Entry : accounting entries

note right of Product
  Unique database constraint:
  (store_id, code)
end note

note right of Category
  Unique database constraints:
  (store_id, parent_id, name) when parent_id is not null
  (store_id, name) when parent_id is null
end note

note right of ProductParameter
  Unique database constraint:
  (product_id, product_parameter_name_id)
end note

note right of CategoryProductParameterName
  Unique database constraint:
  (category_id, product_parameter_name_id)

  ProductType builds productParameters from definitions
  assigned to the selected category and its parents.
end note

note right of Warehouse
  Unique database constraint:
  (store_id, name)
end note

note right of WarehouseProduct
  Unique database constraint:
  (product_id, warehouse_id)

  Database checks:
  purchasePrice >= 0
  minimumSellingPrice >= 0
  sellingPrice >= 0
  count >= 0
  reserveCount >= 0
  reserveCount <= count
end note

note right of Entry
  Database checks:
  cost >= 0
  deliveryCost is null or deliveryCost >= 0
end note

@enduml
