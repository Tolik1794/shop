@startuml

title Shop database

hide circle
skinparam linetype ortho

entity Store {
    * id: int
    --
    * name: string(255)
    * slug: string(255) <<unique>>
    * phone: string(255)
    * email: string(255)
    description: string(255)?
    avatar: string(255)?
    * status: ActiveStatusEnum
    * costingMethod: CostingMethodEnum
    * allowBackorders: bool
    * baseCurrency: Currency
    * createdAt: DateTimeImmutable
    * updatedAt: DateTimeImmutable
}

entity User {
    * id: int
    --
    nickname: string(255)? <<unique>>
    * email: string(180) <<unique>>
    * password: string(255)
    avatar: string(255)?
    firstName: string(255)?
    lastName: string(255)?
    dateOfBirth: date?
    * isVerified: bool
    * roles: json
    parent: User?
}

entity UserStore {
    * user_id: int
    * store_id: int
}

enum RoleEnum {
    ROLE_SUPER_ADMIN
    ROLE_ADMIN
    ROLE_STORE_ADMIN
    ROLE_STORE_MANAGER
    ROLE_USER
}

enum ActiveStatusEnum {
    active
    inactive
}

enum CostingMethodEnum {
    average_cost
    fifo
}

enum ProductPriceType {
    regular
    sale
    wholesale
    custom
}

entity Currency {
    * code: string(3)
    --
    * name: string(255)
    * symbol: string(10)
    * decimalPlaces: int
    * status: ActiveStatusEnum
}

entity ExchangeRate {
    * id: int
    --
    * rate: decimal(18, 8)
    * validFrom: DateTimeImmutable
    validTo: DateTimeImmutable?
    source: string(255)?
    comment: text?
    * createdAt: DateTimeImmutable
    * fromCurrency: Currency
    * toCurrency: Currency
    store: Store?
}

entity Category {
    * id: int
    --
    * name: string(255)
    description: string(255)?
    * level: int
    * status: ActiveStatusEnum
    * createdAt: DateTimeImmutable
    * updatedAt: DateTimeImmutable
    deletedAt: DateTimeImmutable?
    * store: Store
    createdBy: User?
    updatedBy: User?
    parent: Category?
    firstParent: Category?
}

entity AdditionalName {
    * id: int
    --
    * name: string(255)
}

entity CategoryAdditionalName {
    * id: int
    --
    * store: Store
    * category: Category
    * additionalName: AdditionalName
}

enum ProductKindEnum {
    material
    finished_product
    resale_product
    semi_finished_product
    service
}

entity Unit {
    * id: int
    --
    * code: string(50)
    * name: string(255)
    * precision: int
    * status: ActiveStatusEnum
    * createdAt: DateTimeImmutable
    * updatedAt: DateTimeImmutable
    deletedAt: DateTimeImmutable?
    * store: Store
    createdBy: User?
    updatedBy: User?
}

entity Customer {
    * id: int
    --
    * name: string(255)
    phone: string(255)?
    email: string(255)?
    comment: text?
    * status: ActiveStatusEnum
    * createdAt: DateTimeImmutable
    * updatedAt: DateTimeImmutable
    deletedAt: DateTimeImmutable?
    * store: Store
    createdBy: User?
    updatedBy: User?
}

entity Supplier {
    * id: int
    --
    * name: string(255)
    phone: string(255)?
    email: string(255)?
    comment: text?
    * status: ActiveStatusEnum
    * createdAt: DateTimeImmutable
    * updatedAt: DateTimeImmutable
    deletedAt: DateTimeImmutable?
    * store: Store
    createdBy: User?
    updatedBy: User?
}

entity Product {
    * id: int
    --
    * name: string(255)
    * code: string(255)
    * canBeSold: bool
    * canBePurchased: bool
    * canBeManufactured: bool
    * unit: Unit
    baseSalePrice: decimal(14, 4)?
    * status: ActiveStatusEnum
    * createdAt: DateTimeImmutable
    * updatedAt: DateTimeImmutable
    deletedAt: DateTimeImmutable?
    * category: Category
    * store: Store
    createdBy: User?
    updatedBy: User?
    * productKind: ProductKindEnum
}

entity ProductPrice {
    * id: int
    --
    * type: ProductPriceType
    * price: decimal(14, 4)
    * priceBase: decimal(14, 4)
    * validFrom: DateTimeImmutable
    validTo: DateTimeImmutable?
    comment: text?
    * createdAt: DateTimeImmutable
    * updatedAt: DateTimeImmutable
    deletedAt: DateTimeImmutable?
    * product: Product
    * currency: Currency
    * store: Store
    createdBy: User?
    updatedBy: User?
}

entity ProductParameterName {
    * id: int
    --
    * name: string(255)
    * description: string(255)
}

entity ProductParameter {
    * id: int
    --
    * value: string(255)
    * productParameterName: ProductParameterName
    * product: Product
}

entity CategoryProductParameterName {
    * id: int
    --
    * isRequired: bool
    * isFilter: bool
    * productParameterName: ProductParameterName
    * category: Category
}

entity Warehouse {
    * id: int
    --
    * name: string(255)
    * status: ActiveStatusEnum
    * createdAt: DateTimeImmutable
    * updatedAt: DateTimeImmutable
    deletedAt: DateTimeImmutable?
    * store: Store
    createdBy: User?
    updatedBy: User?
}

entity WarehouseStock {
    * id: int
    --
    * quantityOnHand: decimal(14, 4)
    * reservedQuantity: decimal(14, 4)
    * averageCost: decimal(14, 4)
    * createdAt: DateTimeImmutable
    * updatedAt: DateTimeImmutable
    * warehouse: Warehouse
    * product: Product
}

entity WarehouseStockBatch {
    * id: int
    --
    * initialQuantity: decimal(14, 4)
    * remainingQuantity: decimal(14, 4)
    * unitCost: decimal(14, 4)
    salePrice: decimal(14, 4)?
    * receivedAt: DateTimeImmutable
    * createdAt: DateTimeImmutable
    * warehouseStock: WarehouseStock
    purchaseEntry: PurchaseEntry?
    createdByMovement: StockMovement?
}

entity InventoryDocument {
    * id: int
    --
    * number: string(255)
    * type: InventoryDocumentType
    * status: InventoryDocumentStatus
    * documentDate: DateTimeImmutable
    currency: Currency?
    exchangeRateToBase: decimal(18, 8)?
    totalAmount: decimal(14, 4)?
    totalAmountBase: decimal(14, 4)?
    postedAt: DateTimeImmutable?
    canceledAt: DateTimeImmutable?
    comment: text?
    * createdAt: DateTimeImmutable
    * updatedAt: DateTimeImmutable
    * store: Store
    createdBy: User?
    updatedBy: User?
    postedBy: User?
    canceledBy: User?
    reversedDocument: InventoryDocument?
    order: Order?
    purchase: Purchase?
    productionOrder: ProductionOrder?
}

enum InventoryDocumentType {
    purchase_receipt
    sale_shipment
    customer_return
    supplier_return
    production
    write_off
    stock_adjustment
    transfer
    reversal
}

enum InventoryDocumentStatus {
    draft
    posted
    canceled
}


enum InventoryReasonType {
    write_off
    stock_adjustment
    return
    production_loss
    transfer
    initial_stock
    inventory_count
    damage
    other
}

entity InventoryReason {
    * id: int
    --
    * name: string(255)
    * type: InventoryReasonType
    * status: ActiveStatusEnum
    * createdAt: DateTimeImmutable
    * updatedAt: DateTimeImmutable
    deletedAt: DateTimeImmutable?
    * store: Store
    createdBy: User?
    updatedBy: User?
}

entity StatusHistory {
    * id: int
    --
    * entityType: StatusHistoryEntityType
    * entityId: int
    oldStatus: string(100)?
    * newStatus: string(100)
    comment: text?
    * changedAt: DateTimeImmutable
    changedBy: User?
    * store: Store
}

enum StatusHistoryEntityType {
    order
    purchase
    inventory_document
    production_order
}


enum PaymentDirection {
    incoming
    outgoing
}

enum PaymentType {
    cash
    card
    bank_transfer
    online
    refund
    other
}

enum PaymentStatusEnum {
    unpaid
    partially_paid
    paid
    overpaid
    refunded
}

entity Payment {
    * id: int
    --
    * direction: PaymentDirection
    * type: PaymentType
