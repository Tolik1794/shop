{% extends 'knp_menu.html.twig' %}

{% block list %}
    {% if item.hasChildren and options.depth is not same as(0) and item.displayChildren %}
        {% import _self as knp_menu %}
        {% set is_expanded = matcher.isCurrent(item) or matcher.isAncestor(item, options.matchingDepth) %}
        {% set attributes = listAttributes %}
        {% if item.level > 0 and is_expanded %}
            {% set attributes = attributes|merge({'class': (attributes.class|default('') ~ ' show')|trim}) %}
        {% endif %}
        <ul{{ knp_menu.attributes(attributes) }}>
            {{ block('children') }}
        </ul>
    {% endif %}
{% endblock %}

{% block linkElement %}
    {% import _self as knp_menu %}
    {% set linkAttributes = item.linkAttributes %}
    {% if item.hasChildren and item.linkAttribute('data-bs-toggle') == 'collapse' %}
        {% set is_expanded = matcher.isCurrent(item) or matcher.isAncestor(item, options.matchingDepth) %}
        {% set linkAttributes = linkAttributes|merge({
            'aria-expanded': is_expanded ? 'true' : 'false',
            'class': is_expanded ? 'sidebar-link' : 'sidebar-link collapsed'
        }) %}
    {% endif %}
    {% if item.extra('icon') %}
        {% set sidebar_label = item.label|striptags %}
        {% set linkAttributes = linkAttributes|merge({
            'aria-label': linkAttributes['aria-label']|default(sidebar_label),
            'data-sidebar-label': sidebar_label
        }) %}
    {% endif %}
    <a href="{{ item.uri }}"{{ knp_menu.attributes(linkAttributes) }}>{{ block('label') }}</a>
{% endblock %}

{% block label %}
    {% set icon = item.extra('icon') %}
    {% if icon %}
        <i class="fa-solid {{ icon }} fa-fw"></i>
    {% endif %}
    <span class="align-middle">
        {%- if options.allow_safe_labels and item.getExtra('safe_label', false) -%}
            {{- item.label|raw -}}
        {%- else -%}
            {{- item.label -}}
        {%- endif -%}
    </span>
{% endblock %}
