{% extends 'admin/_store_components/layout.html.twig' %}

{% block title %}Supplier{% endblock %}

{% block main_content %}
    <main class="content">
        <div class="container-fluid p-0">
            <div class="row">
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title mb-0">{{ entity.id ? entity.name : 'New' }}</h5>
                    </div>
                    <div class="card-body">
                        {{ form_start(form) }}
                        {% if form.vars.errors|length > 0 %}
                            <div class="form-error">
                                {{ form_errors(form) }}
                            </div>
                        {% endif %}

                        {% for name, widget in form %}
                            {{ form_row(widget) }}
                        {% endfor %}

                        <div class="row">
                            <div class="form-control-lg">
                                <button type="submit" class="btn btn-primary btn mb-1 me-2">Сохранить</button>
                                <button name="save" value="stay" type="submit" class="btn btn-primary mb-1 me-2">Сохранить и продолжить</button>
                                <a href="{{ path('app_admin_supplier_index', {store_id: app.request.attributes.get('store_id')}) }}" class="btn btn-text mb-1">Отмена</a>
                            </div>
                        </div>

                        {{ form_end(form, {'render_rest': false}) }}
                    </div>
                </div>
            </div>
        </div>
    </main>
{% endblock %}
