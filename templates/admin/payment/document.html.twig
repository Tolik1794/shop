{% set is_fully_paid = entity.paymentStatus.value in ['paid', 'overpaid'] %}
{% set actions %}
	<a class="btn btn-light btn-sm" href="{{ full_payment_form_url }}"><i class="fa-solid fa-file-pen me-1"></i>{{ 'Full form'|trans }}</a>
{% endset %}

<div class="card" {{ stimulus_target('reload-card', 'paymentsCard') }} data-card-id="{{ entity.id }}">
	<div class="card-header">
		{{ include('admin/_components/card/_actions.html.twig', {actions: actions}) }}
		<h5 class="card-title mb-0">{{ 'Payments'|trans }}</h5>
	</div>
	<div class="card-body" data-controller="select-two">
		{% if payments|length > 0 %}
			<div class="document-payment-list">
				{% for payment in payments %}
					{% set correction = payment.reversesPayment
						? 'Reversal of #' ~ payment.reversesPayment.id
						: (payment.reversedByPayment ? 'Reversed by #' ~ payment.reversedByPayment.id : '') %}
					{% set reversalReason = payment.reversesPayment
						? payment.comment
						: (payment.reversedByPayment ? payment.reversedByPayment.comment : payment.comment) %}
					<article class="document-payment-card">
						<div class="document-payment-card-header">
							<strong>{{ 'Payment'|trans }} #{{ loop.index }}</strong>
							<span class="text-muted small">{{ payment.paidAt|date('d.m.Y H:i') }}</span>
						</div>
						<div class="text-muted small mb-2">
							{{ payment.direction.value|trans }} · {{ payment.type.value|trans }}
						</div>
						<dl class="document-payment-fields">
							<div>
								<dt>{{ 'Amount'|trans }}</dt>
								<dd>{{ payment.amount|money }} {{ payment.currency.code }}</dd>
							</div>
							<div>
								<dt>{{ 'Amount base'|trans }}</dt>
								<dd>{{ payment.amountBase|money }}</dd>
							</div>
							<div>
								<dt>{{ 'Correction'|trans }}</dt>
								<dd>{{ correction ?: '—' }}</dd>
							</div>
							<div>
								<dt>{{ 'Comment'|trans }}</dt>
								<dd>{{ reversalReason ?: '—' }}</dd>
							</div>
						</dl>
					</article>
				{% endfor %}
			</div>
		{% else %}
			<p class="text-muted">{{ 'No payments.'|trans }}</p>
		{% endif %}

		{% if is_fully_paid %}
			<div class="alert alert-success mb-0 document-payment-status">
				{{ 'This document is fully paid.'|trans }}
			</div>
		{% else %}
			<h6 class="mb-2">{{ 'Add payment'|trans }}</h6>

			{{ form_start(payment_form, {attr: {'data-select-two-target': 'form'}}) }}
			{% if payment_form.vars.errors|length > 0 %}
				<div class="form-error">
					{{ form_errors(payment_form) }}
				</div>
			{% endif %}

			{{ form_row(payment_form.direction) }}
			{{ form_row(payment_form.type) }}
			{{ form_row(payment_form.amount) }}
			{{ form_row(payment_form.paidAt) }}
			{{ form_row(payment_form.currency) }}
			{{ form_row(payment_form.externalReference) }}
			{{ form_row(payment_form.comment) }}

			<button type="submit" class="btn btn-primary btn-sm">
				<i class="fa-solid fa-plus me-1"></i>Add payment
			</button>

			{% if payment_form._token is defined %}
				{{ form_widget(payment_form._token) }}
			{% endif %}

			{{ form_end(payment_form, {'render_rest': false}) }}
		{% endif %}
	</div>
</div>
