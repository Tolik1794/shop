{% set header_badges %}
	{{ include('admin/_components/status/_badge.html.twig', {value: entity.direction.value}) }}
	{{ include('admin/_components/status/_badge.html.twig', {value: entity.type.value}) }}
{% endset %}

<div class="card show-card" {{ stimulus_target('reload-card', 'card') }} data-card-id="{{ entity.id }}">
	{{ include('admin/_components/show_card/_header.html.twig', {
		title: entity.direction.value ~ ' ' ~ ('payment'|trans),
		subtitle: entity.order ? entity.order.number : entity.purchase.number,
		badges: header_badges
	}) }}
	<div class="card-body">
		<table class="table table-sm mt-2 mb-0">
			<tbody>
			<tr><th>{{ 'Date'|trans }}</th><td>{{ entity.paidAt|date('Y-m-d H:i') }}</td></tr>
			<tr><th>{{ 'Direction'|trans }}</th><td>{{ entity.direction.value }}</td></tr>
			<tr><th>{{ 'Type'|trans }}</th><td>{{ entity.type.value }}</td></tr>
			<tr><th>{{ 'Document'|trans }}</th><td>{{ entity.order ? entity.order.number : entity.purchase.number }}</td></tr>
			<tr><th>{{ 'Amount'|trans }}</th><td>{{ entity.amount|money }} {{ entity.currency.code }}</td></tr>
			<tr><th>{{ 'Amount base'|trans }}</th><td>{{ entity.amountBase|money }}</td></tr>
			<tr><th>{{ 'Exchange rate'|trans }}</th><td>{{ entity.exchangeRateToBase }}</td></tr>
			<tr><th>{{ 'External reference'|trans }}</th><td>{{ entity.externalReference }}</td></tr>
			<tr><th>{{ 'Correction'|trans }}</th><td>{{ entity.reversesPayment ? 'Reversal of #'|trans ~ entity.reversesPayment.id : (entity.reversedByPayment ? 'Reversed by #'|trans ~ entity.reversedByPayment.id : '') }}</td></tr>
			{% if entity.reversesPayment %}
				<tr><th>{{ 'Reversal reason'|trans }}</th><td>{{ entity.comment }}</td></tr>
			{% elseif entity.reversedByPayment %}
				<tr><th>{{ 'Reversal reason'|trans }}</th><td>{{ entity.reversedByPayment.comment }}</td></tr>
			{% else %}
				<tr><th>{{ 'Comment'|trans }}</th><td>{{ entity.comment }}</td></tr>
			{% endif %}
			</tbody>
		</table>

		{% if entity.type.value != 'refund' and not entity.reversedByPayment %}
			<form method="post" action="{{ path('app_admin_payment_reverse', {store_id: app.request.attributes.get('store_id'), id: entity.id}) }}" class="mt-3" onsubmit="return confirm('{{ 'Reverse this payment?'|trans|e('js') }}');">
				<input type="hidden" name="_token" value="{{ csrf_token('reverse_payment_' ~ entity.id) }}">
				<label for="payment-reversal-reason-{{ entity.id }}" class="form-label">{{ 'Reason for reversal'|trans }}</label>
				<textarea id="payment-reversal-reason-{{ entity.id }}" name="reason" class="form-control form-control-sm mb-2" rows="2" required></textarea>
				<button class="btn btn-light btn-sm" type="submit"><i class="fa-solid fa-rotate-left me-1"></i>{{ 'Reverse'|trans }}</button>
			</form>
		{% endif %}
	</div>
</div>
