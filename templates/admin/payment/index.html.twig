{% extends 'admin/_store_components/layout.html.twig' %}

{% block title %}Payments{% endblock %}

{% set table_actions %}
	{% if is_granted('ROLE_STORE_ADMIN') %}
		<a class="btn btn-light btn-sm" href="{{ path('app_admin_payment_new', {store_id: app.request.attributes.get('store_id')}) }}"><i class="fa-solid fa-plus me-1"></i>New</a>
	{% endif %}
{% endset %}

{% set table_head %}
	<tr>
		<th>Date</th>
		<th>Direction</th>
		<th>Type</th>
		<th>Document</th>
		<th>Amount</th>
		<th>Correction</th>
		<th>Reason</th>
	</tr>
{% endset %}

{% set table_body %}
	{% for entity in pagination %}
		{% set correction = entity.reversesPayment
			? 'Reversal of #' ~ entity.reversesPayment.id
			: (entity.reversedByPayment ? 'Reversed by #' ~ entity.reversedByPayment.id : '') %}
		{% set reversalReason = entity.reversesPayment
			? entity.comment
			: (entity.reversedByPayment ? entity.reversedByPayment.comment : '') %}
		<tr
				id="{{ entity.id }}"
				data-id-column="id"
				class="{{ first_entity and entity.id == first_entity.id ? 'table-active' : '' }}"
				data-action="click->reload-card#reloadCard click->reload-card#tableActivate"
				data-link="{{ path('app_admin_payment_show', {store_id: app.request.attributes.get('store_id'), id: entity.id}) }}"
				onclick="document.getElementById('first-tab').click()"
		>
			<td>{{ entity.paidAt|date('Y-m-d H:i') }}</td>
			<td>{{ entity.direction.value }}</td>
			<td>{{ entity.type.value }}</td>
			<td>{{ entity.order ? entity.order.number : entity.purchase.number }}</td>
			<td>{{ entity.amount|money }} {{ entity.currency.code }}</td>
			<td>{{ correction ?: '—' }}</td>
			<td>{{ reversalReason ?: '—' }}</td>
		</tr>
	{% endfor %}
{% endset %}

{% block main_content %}
	<main class="content" {{ stimulus_controller('reload-card') }}>
		<div class="container-fluid p-0">
			<div class="row">
				<div class="col-xxl-4 col-xl-5 col-lg-6">
					{{ include('admin/_components/card/_tab_card.html.twig', {
						tab_search_key: 1,
						tab_head: [
							include('admin/_components/tab_icon/_show.html.twig'),
							include('admin/_components/tab_icon/_filter.html.twig')
							~ (app.request.query.all(filter_form.vars.name) ? '<span style="color: red">*</span>' : '')
						],
						tab_body: [
							first_entity ? render(controller(
								'App\\Controller\\Admin\\PaymentController::show',
								{ store_id: app.request.attributes.get('store_id'), id: first_entity.id, 'request': app.request }
							)) : '<div class="card"><div class="card-body">Nothing to show...</div></div>',
							include('admin/_components/card/_filter_card.html.twig', {form: filter_form})
						]
					}) }}
				</div>
				<div class="col-xxl-8 col-xl-7 col-lg-6">
					{{ include('admin/_components/card/_table_card.html.twig', {
						actions: table_actions,
						table_title: 'Payments',
						table_head: table_head,
						table_body: table_body
					}) }}
				</div>
			</div>
		</div>
	</main>
{% endblock %}
