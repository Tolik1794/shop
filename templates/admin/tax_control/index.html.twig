{% extends 'admin/layout.html.twig' %}

{% block title %}{{ 'admin.tax_control.title.list'|trans }}{% endblock %}

{% block navbar_breadcrumb %}
    {% set page_breadcrumb %}
        {{ include('admin/_components/_resource_breadcrumb.html.twig', {
            section_label: 'admin.tax_control.title.list'|trans
        }) }}
    {% endset %}
    {{ include('admin/_components/_navbar_header.html.twig', {
        title: 'admin.tax_control.title.list'|trans,
        breadcrumb: page_breadcrumb
    }) }}
{% endblock %}

{% block main_content %}
    <main class="content">
        <div class="container-fluid p-0">

            <div class="d-flex align-items-center gap-2 mb-3">
                <form method="get" class="d-flex align-items-end gap-2">
                    <div>
                        <label class="form-label mb-1" for="tc-year">{{ 'admin.tax_control.filters.year'|trans }}</label>
                        <input id="tc-year" class="form-control form-control-sm" type="number" name="year"
                               value="{{ year }}" min="2020" max="2030" style="width:90px">
                    </div>
                    <button class="btn btn-primary btn-sm" type="submit">
                        <i class="fa-solid fa-filter me-1"></i>{{ 'admin.common.filter'|trans }}
                    </button>
                </form>
                <div class="ms-auto">
                    <a class="btn btn-light btn-sm" href="{{ path('admin_tax_income_index') }}">
                        <i class="fa-solid fa-list me-1"></i>{{ 'admin.menu.tax_income'|trans }}
                    </a>
                </div>
            </div>

            {% if statuses is empty %}
                <div class="alert alert-info">
                    {{ 'admin.tax_control.no_entities'|trans }}
                    <a href="{{ path('admin_legal_entity_new') }}">{{ 'admin.tax_control.add_entity'|trans }}</a>
                </div>
            {% else %}
                <div class="row">
                    {% for status in statuses %}
                        {% set alert = status.alertLevel %}
                        <div class="col-xl-6 col-12">
                            <div class="card border-0 shadow-sm">
                                <div class="card-header d-flex justify-content-between align-items-center pb-2">
                                    <div>
                                        <h5 class="card-title mb-0">
                                            <a href="{{ path('admin_tax_control_show', {id: status.legalEntity.id, year: year}) }}"
                                               class="text-reset text-decoration-none">
                                                {{ status.legalEntity }}
                                            </a>
                                        </h5>
                                        <div class="text-muted small">
                                            {{ status.legalEntity.taxNumber }}
                                            {% if status.legalEntity.epGroup %}
                                                &middot; {{ 'admin.legal_entity.fields.ep_group'|trans }} {{ status.legalEntity.epGroup }}
                                                {% if status.legalEntity.epRate %} / {{ status.legalEntity.epRate|number_format(0) }}%{% endif %}
                                            {% endif %}
                                            &middot; {{ year }}
                                        </div>
                                    </div>
                                    {% if alert == 'exceeded' %}
                                        <span class="badge bg-danger">{{ 'admin.tax_control.alert.exceeded'|trans }}</span>
                                    {% elseif alert == 'critical' %}
                                        <span class="badge bg-danger">{{ 'admin.tax_control.alert.critical'|trans }}</span>
                                    {% elseif alert == 'warning' %}
                                        <span class="badge bg-warning text-dark">{{ 'admin.tax_control.alert.warning'|trans }}</span>
                                    {% elseif alert == 'notice' %}
                                        <span class="badge bg-info text-dark">{{ 'admin.tax_control.alert.notice'|trans }}</span>
                                    {% endif %}
                                </div>
                                <div class="card-body">

                                    {% if status.limit %}
                                        <div class="mb-2">
                                            <div class="d-flex justify-content-between mb-1">
                                                <span class="small">{{ status.incomeTotal|money }} {{ 'admin.tax_control.of'|trans }} {{ status.limit|money }}</span>
                                                <strong class="small">{{ status.percent|number_format(1) }}%</strong>
                                            </div>
                                            <div class="progress" style="height:10px">
                                                <div class="progress-bar {{ status.progressBarClass }}"
                                                     style="width:{{ status.percentClamped|number_format(2) }}%"
                                                     role="progressbar"
                                                     aria-valuenow="{{ status.percentClamped|number_format(2) }}"
                                                     aria-valuemin="0" aria-valuemax="100"></div>
                                            </div>
                                        </div>
                                        <div class="row text-center small mt-2">
                                            <div class="col-4 border-end">
                                                <div class="text-muted">{{ 'admin.tax_control.fields.used'|trans }}</div>
                                                <strong>{{ status.incomeTotal|money }}</strong>
                                            </div>
                                            <div class="col-4 border-end">
                                                <div class="text-muted">{{ 'admin.tax_control.fields.remaining'|trans }}</div>
                                                <strong class="{{ status.remaining|default(0)|number_format(4, '.', '') < 0 ? 'text-danger' : '' }}">
                                                    {{ status.remaining|money }}
                                                </strong>
                                            </div>
                                            <div class="col-4">
                                                <div class="text-muted">{{ 'admin.tax_control.fields.limit'|trans }}</div>
                                                <strong>{{ status.limit|money }}</strong>
                                            </div>
                                        </div>
                                    {% else %}
                                        <div class="text-muted small">
                                            <strong>{{ 'admin.tax_control.fields.income_total'|trans }}:</strong>
                                            {{ status.incomeTotal|money }}
                                        </div>
                                        <div class="text-muted small mt-1">{{ 'admin.tax_control.no_limit'|trans }}</div>
                                    {% endif %}

                                    {% if status.forecastAnnual %}
                                        <div class="mt-2 pt-2 border-top small text-muted">
                                            <i class="fa-solid fa-chart-line me-1"></i>
                                            {{ 'admin.tax_control.forecast.annual'|trans }}: <strong>{{ status.forecastAnnual|money }}</strong>
                                            {% if status.forecastLimitDate %}
                                                &middot; {{ 'admin.tax_control.forecast.limit_date'|trans }}:
                                                <strong>{{ status.forecastLimitDate|date('d.m.Y') }}</strong>
                                            {% endif %}
                                        </div>
                                    {% endif %}

                                </div>
                                <div class="card-footer d-flex justify-content-end py-2">
                                    <a href="{{ path('admin_tax_control_show', {id: status.legalEntity.id, year: year}) }}"
                                       class="btn btn-light btn-sm">
                                        <i class="fa-solid fa-chart-bar me-1"></i>{{ 'admin.tax_control.actions.details'|trans }}
                                    </a>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}

            <div class="mt-3 text-muted small">
                <i class="fa-solid fa-circle-info me-1"></i>{{ 'admin.legal_entity.disclaimer'|trans }}
            </div>
        </div>
    </main>
{% endblock %}
