{% set primary_action %}
	{% if entity.status.value == 'draft' %}
		<form method="post" action="{{ path('app_admin_inventory_document_post', {store_id: app.request.attributes.get('store_id'), id: entity.id}) }}" class="d-inline" data-action="submit->reload-card#submitQuickAction" data-confirm-message="{{ 'Post inventory document?'|trans }}">
			<input type="hidden" name="_token" value="{{ csrf_token('post_inventory_document_' ~ entity.id) }}">
			<button class="btn btn-success btn-sm" type="submit"><i class="fa-solid fa-check me-1"></i>{{ 'Post'|trans }}</button>
		</form>
	{% endif %}
{% endset %}

{% set secondary_actions %}
	{% if entity.status.value != 'canceled' %}
		<form method="post" action="{{ path('app_admin_inventory_document_cancel', {store_id: app.request.attributes.get('store_id'), id: entity.id}) }}" class="m-0" data-action="submit->reload-card#submitQuickAction" data-confirm-message="{{ 'Cancel inventory document?'|trans }}">
			<input type="hidden" name="_token" value="{{ csrf_token('cancel_inventory_document_' ~ entity.id) }}">
			<button class="dropdown-item text-danger" type="submit"><i class="fa-solid fa-ban me-1"></i>{{ 'Cancel'|trans }}</button>
		</form>
	{% endif %}
{% endset %}
{% set show_more_actions = secondary_actions|trim or not primary_action|trim %}
{% set header_badges %}
	{{ include('admin/_components/status/_badge.html.twig', {context: 'inventory', value: entity.status.value}) }}
{% endset %}

<div class="card show-card" {{ stimulus_target('reload-card', 'card') }} data-card-id="{{ entity.id }}">
	{{ include('admin/_components/show_card/_header.html.twig', {
		title: entity.number,
		subtitle: entity.type.value,
		badges: header_badges,
		primary_action: primary_action,
		secondary_actions: secondary_actions,
		show_more: show_more_actions
	}) }}
	<div class="card-body">
		<table class="table table-sm mt-2 mb-4">
			<tbody>
			<tr><th>{{ 'Date'|trans }}</th><td>{{ entity.documentDate|date('Y-m-d') }}</td></tr>
			<tr><th>{{ 'Type'|trans }}</th><td>{{ entity.type.value }}</td></tr>
			<tr><th>{{ 'Status'|trans }}</th><td>{{ entity.status.value }}</td></tr>
			<tr><th>{{ 'Currency'|trans }}</th><td>{{ entity.currency ? entity.currency.code : '—' }}</td></tr>
			<tr><th>{{ 'Exchange rate'|trans }}</th><td>{{ entity.exchangeRateToBase ?: '—' }}</td></tr>
			<tr><th>{{ 'Total'|trans }}</th><td>{{ entity.totalAmount is not null ? entity.totalAmount|money : '—' }}</td></tr>
			<tr><th>{{ 'Total base'|trans }}</th><td>{{ entity.totalAmountBase is not null ? entity.totalAmountBase|money : '—' }}</td></tr>
			<tr><th>{{ 'Reason'|trans }}</th><td>{{ entity.reason ? entity.reason.name ~ ' (' ~ entity.reason.type.value ~ ')' : '—' }}</td></tr>
			<tr>
				<th>{{ 'Linked document'|trans }}</th>
				<td>
					{% if entity.order %}
						<a href="{{ path('app_admin_order_index', {store_id: app.request.attributes.get('store_id'), id: entity.order.id}) }}">{{ 'Order'|trans }} {{ entity.order.number }}</a>
					{% elseif entity.purchase %}
						<a href="{{ path('app_admin_purchase_index', {store_id: app.request.attributes.get('store_id'), id: entity.purchase.id}) }}">{{ 'Purchase'|trans }} {{ entity.purchase.number }}</a>
					{% elseif entity.productionOrder %}
						<a href="{{ path('app_admin_production_order_index', {store_id: app.request.attributes.get('store_id'), id: entity.productionOrder.id}) }}">{{ 'Production'|trans }} #{{ entity.productionOrder.id }}</a>
					{% else %}
						<span class="text-muted">—</span>
					{% endif %}
				</td>
			</tr>
			<tr><th>{{ 'Posted at'|trans }}</th><td>{{ entity.postedAt ? entity.postedAt|date('Y-m-d H:i') : '—' }}</td></tr>
			<tr><th>{{ 'Canceled at'|trans }}</th><td>{{ entity.canceledAt ? entity.canceledAt|date('Y-m-d H:i') : '—' }}</td></tr>
			<tr><th>{{ 'Reversed document'|trans }}</th><td>{{ entity.reversedDocument ? entity.reversedDocument.number : '—' }}</td></tr>
			<tr><th>{{ 'Comment'|trans }}</th><td>{{ entity.comment ?: '—' }}</td></tr>
			</tbody>
		</table>

		<h6 class="mt-4 mb-2">{{ 'Lines'|trans }}</h6>
		<table class="table table-sm mb-4">
			<thead>
			<tr>
				<th>{{ 'Product'|trans }}</th>
				<th>{{ 'Warehouse'|trans }}</th>
				<th>{{ 'Direction'|trans }}</th>
				<th>{{ 'Quantity'|trans }}</th>
				<th>{{ 'Unit price'|trans }}</th>
				<th>{{ 'Total'|trans }}</th>
			</tr>
			</thead>
			<tbody>
			{% for line in entity.lines %}
				<tr>
					<td>{{ line.product.name }} <span class="text-muted">({{ line.product.code }})</span></td>
					<td>{{ line.warehouse.name }}</td>
					<td>{{ line.direction.value }}</td>
					<td>{{ line.quantity|quantity(line.product) }}</td>
					<td>{{ line.unitPrice is not null ? line.unitPrice|money : '—' }}</td>
					<td>{{ line.totalPrice is not null ? line.totalPrice|money : '—' }}</td>
				</tr>
			{% else %}
				<tr><td colspan="6" class="text-muted">{{ 'No lines.'|trans }}</td></tr>
			{% endfor %}
			</tbody>
		</table>

		<h6 class="mt-4 mb-2">{{ 'Stock movements'|trans }}</h6>
		<table class="table table-sm mb-0">
			<thead>
			<tr>
				<th>{{ 'Line'|trans }}</th>
				<th>{{ 'Created'|trans }}</th>
				<th>{{ 'Quantity change'|trans }}</th>
				<th>{{ 'Unit cost'|trans }}</th>
				<th>{{ 'Balance after'|trans }}</th>
			</tr>
			</thead>
			<tbody>
			{% for line in entity.lines %}
				{% for movement in line.stockMovements %}
					<tr>
						<td>{{ line.product.name }} · {{ line.warehouse.name }}</td>
						<td>{{ movement.createdAt|date('Y-m-d H:i') }}</td>
						<td>{{ movement.quantityChange|quantity(line.product) }}</td>
						<td>{{ movement.unitCost|money }}</td>
						<td>{{ movement.balanceAfter is not null ? movement.balanceAfter|quantity(line.product) : '—' }}</td>
					</tr>
				{% endfor %}
			{% else %}
			{% endfor %}
			{% if entity.lines|filter(line => line.stockMovements|length > 0)|length == 0 %}
				<tr><td colspan="5" class="text-muted">{{ 'No stock movements yet.'|trans }}</td></tr>
			{% endif %}
			</tbody>
		</table>
	</div>
</div>
