<tr
		id="{{ entity.id }}"
		data-id-column="id"
		class="{{ first_entity and entity.id == first_entity.id ? 'table-active' : '' }}"
	data-action="click->reload-card#reloadDocumentCards click->reload-card#tableActivate"
	data-show-link="{{ path('app_admin_inventory_document_show', {store_id: app.request.attributes.get('store_id'), id: entity.id}) }}"
	data-history-link="{{ path('app_admin_inventory_document_history', {store_id: app.request.attributes.get('store_id'), id: entity.id}) }}"
	data-breadcrumb-label="{{ entity.number }}"
>
	<td>{{ entity.documentDate|date('Y-m-d') }}</td>
	<td><strong>{{ entity.number }}</strong></td>
	<td>{{ entity.type.value }}</td>
	<td>{{ entity.status.value }}</td>
	<td>
		{% if entity.order %}
			Order {{ entity.order.number }}
		{% elseif entity.purchase %}
			Purchase {{ entity.purchase.number }}
		{% elseif entity.productionOrder %}
			Production #{{ entity.productionOrder.id }}
		{% else %}
			<span class="text-muted">—</span>
		{% endif %}
	</td>
	<td>{{ entity.reason ? entity.reason.name : '—' }}</td>
</tr>
