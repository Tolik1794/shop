{% extends 'admin/_store_components/layout.html.twig' %}

{% block title %}Inventory documents{% endblock %}

{% set table_actions %}
	<div class="dropdown d-inline-block">
		<button class="btn btn-light btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
			<i class="fa-solid fa-plus me-1"></i>{{ 'New operation'|trans }}
		</button>
		<ul class="dropdown-menu dropdown-menu-end">
			<li><a class="dropdown-item" href="{{ path('app_admin_inventory_document_write_off_new', {store_id: app.request.attributes.get('store_id')}) }}">{{ 'Write-off'|trans }}</a></li>
			<li><a class="dropdown-item" href="{{ path('app_admin_inventory_document_stock_adjustment_new', {store_id: app.request.attributes.get('store_id')}) }}">{{ 'Stock adjustment'|trans }}</a></li>
			<li><a class="dropdown-item" href="{{ path('app_admin_inventory_document_transfer_new', {store_id: app.request.attributes.get('store_id')}) }}">{{ 'Transfer'|trans }}</a></li>
			<li><hr class="dropdown-divider"></li>
			<li><a class="dropdown-item" href="{{ path('app_admin_inventory_document_customer_return_new', {store_id: app.request.attributes.get('store_id')}) }}">{{ 'Customer return'|trans }}</a></li>
			<li><a class="dropdown-item" href="{{ path('app_admin_inventory_document_supplier_return_new', {store_id: app.request.attributes.get('store_id')}) }}">{{ 'Supplier return'|trans }}</a></li>
		</ul>
	</div>
{% endset %}

{% set table_head %}
	<tr>
		<th>{{ 'Date'|trans }}</th>
		<th>{{ 'Number'|trans }}</th>
		<th>{{ 'Type'|trans }}</th>
		<th>{{ 'Status'|trans }}</th>
		<th>{{ 'Document'|trans }}</th>
		<th>{{ 'Reason'|trans }}</th>
	</tr>
{% endset %}

{% set table_body %}
	{% for entity in pagination %}
		{{ include('admin/inventory_document/_index_row.html.twig', {entity: entity, first_entity: first_entity}) }}
	{% endfor %}
{% endset %}

{% block main_content %}
	<main class="content" {{ stimulus_controller('reload-card') }}>
		<div class="container-fluid p-0">
			{{ include('admin/_components/_quick_action_flashes.html.twig') }}

			<div class="row">
				<div class="col-xxl-4 col-xl-5 col-lg-6">
					{{ include('admin/_components/card/_tab_card.html.twig', {
						tab_search_key: 2,
						tab_head: [
							include('admin/_components/tab_icon/_show.html.twig'),
							include('admin/_components/tab_icon/_history.html.twig'),
							include('admin/_components/tab_icon/_filter.html.twig')
							~ (app.request.query.all(filter_form.vars.name) ? '<span style="color: red">*</span>' : '')
						],
						tab_body: [
							first_entity ? render(controller(
								'App\\Controller\\Admin\\InventoryDocumentController::show',
								{ store_id: app.request.attributes.get('store_id'), id: first_entity.id, 'request': app.request }
							)) : '<div class="card"><div class="card-body">' ~ 'Nothing to show...'|trans ~ '</div></div>',
							first_entity ? render(controller(
								'App\\Controller\\Admin\\InventoryDocumentController::history',
								{ store_id: app.request.attributes.get('store_id'), id: first_entity.id }
							)) : '<div class="card"><div class="card-body">' ~ 'Nothing to show...'|trans ~ '</div></div>',
							include('admin/_components/card/_filter_card.html.twig', {form: filter_form})
						]
					}) }}
				</div>
				<div class="col-xxl-8 col-xl-7 col-lg-6">
					{{ include('admin/_components/card/_table_card.html.twig', {
						actions: table_actions,
						table_title: 'Inventory documents',
						table_head: table_head,
						table_body: table_body
					}) }}
				</div>
			</div>
		</div>
	</main>
{% endblock %}
