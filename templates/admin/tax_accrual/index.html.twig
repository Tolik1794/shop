{% extends 'admin/layout.html.twig' %}

{% block title %}{{ 'admin.tax_accrual.title.list'|trans }}{% endblock %}

{% block navbar_breadcrumb %}
    {% set page_breadcrumb %}
        {{ include('admin/_components/_resource_breadcrumb.html.twig', {
            section_label: 'admin.tax_accrual.title.list'|trans
        }) }}
    {% endset %}
    {{ include('admin/_components/_navbar_header.html.twig', {
        title: 'admin.tax_accrual.title.list'|trans,
        breadcrumb: page_breadcrumb
    }) }}
{% endblock %}

{% block main_content %}
    <main class="content">
        <div class="container-fluid p-0">

            {# Filters + generate #}
            <div class="d-flex flex-wrap align-items-end gap-2 mb-3">
                <form method="get" class="d-flex align-items-end gap-2 flex-wrap">
                    <div>
                        <label class="form-label mb-1" for="ta-year">{{ 'admin.tax_control.filters.year'|trans }}</label>
                        <input id="ta-year" class="form-control form-control-sm" type="number" name="year"
                               value="{{ year }}" min="2020" max="2030" style="width:90px">
                    </div>
                    <div>
                        <label class="form-label mb-1" for="ta-entity">{{ 'admin.tax_income.fields.legal_entity'|trans }}</label>
                        <select id="ta-entity" class="form-select form-select-sm" name="entity" style="min-width:200px">
                            <option value="">{{ 'admin.tax_accrual.filters.all_entities'|trans }}</option>
                            {% for le in legal_entities %}
                                <option value="{{ le.id }}"{{ current_entity and current_entity.id == le.id ? ' selected' : '' }}>{{ le }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <button class="btn btn-primary btn-sm" type="submit">
                        <i class="fa-solid fa-filter me-1"></i>{{ 'admin.common.filter'|trans }}
                    </button>
                </form>

                <div class="ms-auto d-flex gap-2">
                    <form method="post" action="{{ path('admin_tax_accrual_generate') }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('generate_accruals') }}">
                        <input type="hidden" name="year" value="{{ year }}">
                        {% if current_entity %}
                            <input type="hidden" name="entity_id" value="{{ current_entity.id }}">
                        {% endif %}
                        <button class="btn btn-light btn-sm" type="submit"
                                onclick="return confirm('{{ 'admin.tax_accrual.generate_confirm'|trans|e('js') }}')">
                            <i class="fa-solid fa-rotate me-1"></i>{{ 'admin.tax_accrual.actions.generate'|trans }}
                        </button>
                    </form>
                    <a href="{{ path('admin_tax_control_index', {year: year}) }}" class="btn btn-light btn-sm">
                        <i class="fa-solid fa-chart-pie me-1"></i>{{ 'admin.menu.tax_control'|trans }}
                    </a>
                </div>
            </div>

            {% if accruals is empty %}
                <div class="alert alert-info">
                    {{ 'admin.tax_accrual.no_accruals'|trans }}
                    {% if current_entity %}
                        <br><small>{{ 'admin.tax_accrual.generate_hint'|trans }}</small>
                    {% endif %}
                </div>
            {% else %}
                <div class="card">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead>
                            <tr>
                                {% if not current_entity %}<th>{{ 'admin.tax_income.fields.legal_entity'|trans }}</th>{% endif %}
                                <th>{{ 'admin.tax_accrual.fields.period'|trans }}</th>
                                <th>{{ 'admin.tax_accrual.fields.tax_type'|trans }}</th>
                                <th class="text-end">{{ 'admin.tax_accrual.fields.accrued'|trans }}</th>
                                <th class="text-end">{{ 'admin.tax_accrual.fields.paid'|trans }}</th>
                                <th>{{ 'admin.tax_accrual.fields.due_date'|trans }}</th>
                                <th>{{ 'admin.tax_accrual.fields.status'|trans }}</th>
                                <th></th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for accrual in accruals %}
                                {% set overdue = accrual.status.value == 'accrued' and accrual.dueDate < today %}
                                <tr class="{{ overdue ? 'table-danger' : (accrual.status.value == 'paid' ? 'table-light text-muted' : '') }}">
                                    {% if not current_entity %}
                                        <td>{{ accrual.legalEntity }}</td>
                                    {% endif %}
                                    <td>
                                        {% if accrual.period %}
                                            <span class="small">
                                                {{ accrual.period.dateFrom|date('d.m.Y') }}
                                                – {{ accrual.period.dateTo|date('d.m.Y') }}
                                            </span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <span class="badge {{ accrual.taxType.value == 'ep' ? 'bg-primary' : (accrual.taxType.value == 'esv' ? 'bg-success' : 'bg-warning text-dark') }}">
                                            {{ ('admin.tax_accrual.tax_type.' ~ accrual.taxType.value)|trans }}
                                        </span>
                                    </td>
                                    <td class="text-end">{{ accrual.accruedAmount|money }}</td>
                                    <td class="text-end">
                                        {% if accrual.status.value == 'paid' %}{{ accrual.paidAmount|money }}{% else %}—{% endif %}
                                    </td>
                                    <td>
                                        <span class="{{ overdue ? 'text-danger fw-bold' : '' }}">
                                            {{ accrual.dueDate|date('d.m.Y') }}
                                        </span>
                                        {% if overdue %}
                                            <i class="fa-solid fa-circle-exclamation text-danger ms-1" title="{{ 'admin.tax_accrual.overdue'|trans }}"></i>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if overdue %}
                                            <span class="badge bg-danger">{{ 'admin.tax_accrual.status.overdue'|trans }}</span>
                                        {% elseif accrual.status.value == 'paid' %}
                                            <span class="badge bg-success">{{ 'admin.tax_accrual.status.paid'|trans }}</span>
                                            {% if accrual.paidAt %}
                                                <div class="small text-muted">{{ accrual.paidAt|date('d.m.Y') }}</div>
                                            {% endif %}
                                        {% else %}
                                            <span class="badge bg-secondary">{{ 'admin.tax_accrual.status.accrued'|trans }}</span>
                                        {% endif %}
                                    </td>
                                    <td class="text-end">
                                        {% if accrual.status.value != 'paid' %}
                                            <button class="btn btn-success btn-sm"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#modal-pay-{{ accrual.id }}">
                                                <i class="fa-solid fa-check me-1"></i>{{ 'admin.tax_accrual.actions.mark_paid'|trans }}
                                            </button>
                                        {% else %}
                                            <form method="post" action="{{ path('admin_tax_accrual_reopen', {id: accrual.id}) }}" class="d-inline">
                                                <input type="hidden" name="_token" value="{{ csrf_token('reopen_accrual_' ~ accrual.id) }}">
                                                <button class="btn btn-light btn-sm text-muted" type="submit">{{ 'admin.tax_accrual.actions.reopen'|trans }}</button>
                                            </form>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            {% endif %}

            <div class="mt-3 text-muted small">
                <i class="fa-solid fa-circle-info me-1"></i>{{ 'admin.legal_entity.disclaimer'|trans }}
            </div>
        </div>
    </main>

    {# Mark-paid modals #}
    {% for accrual in accruals %}
        {% if accrual.status.value != 'paid' %}
            <div class="modal fade" id="modal-pay-{{ accrual.id }}" tabindex="-1">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">{{ 'admin.tax_accrual.actions.mark_paid'|trans }}</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <form method="post" action="{{ path('admin_tax_accrual_mark_paid', {id: accrual.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('mark_paid_' ~ accrual.id) }}">
                            <div class="modal-body">
                                <div class="mb-3">
                                    <label class="form-label">{{ 'admin.tax_accrual.fields.paid_at'|trans }}</label>
                                    <input type="date" name="paid_at" class="form-control"
                                           value="{{ 'now'|date('Y-m-d') }}" required>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">{{ 'admin.tax_accrual.fields.paid_amount'|trans }}</label>
                                    <input type="number" name="paid_amount" class="form-control"
                                           step="0.01" value="{{ accrual.accruedAmount|number_format(2, '.', '') }}" required>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-light" data-bs-dismiss="modal">{{ 'admin.common.cancel'|trans }}</button>
                                <button type="submit" class="btn btn-success">{{ 'admin.common.save'|trans }}</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        {% endif %}
    {% endfor %}
{% endblock %}
