{% set actions %}
    <a class="btn btn-light btn-sm" href="{{ path('app_admin_unit_edit', query_params|merge({store_id: app.request.attributes.get('store_id'), id: entity.id})) }}"><i class="fa-solid fa-pen me-1"></i>{{ 'Edit'|trans }}</a>
{% endset %}

<div class="card" {{ stimulus_target('reload-card', 'card') }} data-card-id="{{ entity.id }}">
    <div class="card-header">
        {% if actions|trim %}
            {{ include('admin/_components/card/_actions.html.twig', {actions: actions}) }}
        {% endif %}
        <h5 class="card-title mb-0">{{ entity.name }}</h5>
    </div>
    <div class="card-body">
        <table class="table table-sm mt-2 mb-4">
            <tbody>
            <tr>
                <th>{{ 'Code'|trans }}</th>
                <td>{{ entity.code }}</td>
            </tr>
            <tr>
                <th>{{ 'Name'|trans }}</th>
                <td>{{ entity.name }}</td>
            </tr>
            <tr>
                <th>{{ 'Precision'|trans }}</th>
                <td>{{ entity.precision }}</td>
            </tr>
            <tr>
                <th>{{ 'Status'|trans }}</th>
                <td>{{ entity.status.value }}</td>
            </tr>
            <tr>
                <th>{{ 'Store'|trans }}</th>
                <td>{{ entity.store }}</td>
            </tr>
            </tbody>
        </table>

        <p class="text-muted small mb-2">{{ 'Archived units remain available for historical documents and reports.'|trans }}</p>
        <form method="post" action="{{ path('app_admin_unit_archive', {store_id: app.request.attributes.get('store_id'), id: entity.id}) }}" onsubmit="return confirm('{{ 'Archive unit? Historical documents will remain readable.'|trans|e('js') }}');">
            <input type="hidden" name="_token" value="{{ csrf_token('archive_unit_' ~ entity.id) }}">
            <button class="btn btn-danger btn-sm" type="submit">{{ 'Archive'|trans }}</button>
        </form>
    </div>
</div>
