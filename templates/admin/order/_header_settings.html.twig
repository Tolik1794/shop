<div class="card mb-3 order-settings-card">
    <div class="card-header">
        <h5 class="card-title mb-0">Загальні налаштування</h5>
    </div>
    <div class="card-body">
        <div class="row g-3">
            <div class="d-none">{{ form_widget(form.customer) }}</div>
            <div class="col-md-6 position-relative order-customer-search">
                {{ form_label(form.customerPhone) }}
                {{ form_widget(form.customerPhone) }}
                {{ form_errors(form.customerPhone) }}
                <div class="order-customer-results d-none" data-order-form-target="customerResults"></div>
            </div>
            <div class="col-md-6">{{ form_row(form.customerName) }}</div>
            <div class="col-md-6">{{ form_row(form.customerLastName) }}</div>
            <div class="col-md-6">{{ form_row(form.currency) }}</div>
            <div class="col-md-6">{{ form_row(form.deliveryAddress) }}</div>
            <div class="col-md-6">{{ form_row(form.comment) }}</div>
        </div>
    </div>
</div>
