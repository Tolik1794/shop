{% extends 'admin/_store_components/layout.html.twig' %}

{% block title %}Order{% endblock %}

{% block navbar_breadcrumb %}
    {% set page_breadcrumb %}
        {{ include('admin/_components/_resource_breadcrumb.html.twig', {
            section_label: 'Orders',
            section_url: entity.id
                ? path('app_admin_order_index', {store_id: app.request.attributes.get('store_id'), id: entity.id, page: order_index_page})
                : path('app_admin_order_index', {store_id: app.request.attributes.get('store_id')}),
            current_label: entity.id ? entity.number : 'New'
        }) }}
    {% endset %}
    {{ include('admin/_components/_navbar_header.html.twig', {
        title: entity.id ? 'admin.order.title.edit'|trans : 'admin.order.title.new'|trans,
        subtitle: entity.number,
        breadcrumb: page_breadcrumb
    }) }}
{% endblock %}

{% block main_content %}
    {{ include('admin/order/_form.html.twig') }}
{% endblock %}
