<div class="order-discussion"
     {{ stimulus_controller('draft-order-comments') }}
     data-draft-order-comments-next-index-value="{{ form.draftComments|length }}">
    <div class="card mt-3">
        <div class="card-body">
            <h5 class="card-title mb-3">{{ 'Comments'|trans }}</h5>
            <div class="order-discussion-scroll-frame">
                <div class="order-discussion-scroll order-discussion-comments" data-draft-order-comments-target="list">
                    {% for draft_comment in form.draftComments %}
                        {{ include('admin/order/_draft_comment_item.html.twig', {
                            field_name: draft_comment.vars.full_name,
                            body: draft_comment.vars.value,
                            order_form_id: order_form_id
                        }) }}
                    {% endfor %}

                    <p class="text-muted mb-0{% if form.draftComments|length > 0 %} d-none{% endif %}" data-draft-order-comments-target="emptyState">{{ 'No comments.'|trans }}</p>
                </div>
            </div>

            <form class="mt-3" data-action="submit->draft-order-comments#add">
                <label for="order-comment-body-new" class="form-label">{{ 'Add comment'|trans }}</label>
                <textarea id="order-comment-body-new" class="form-control mb-2" rows="3" required data-draft-order-comments-target="newBody"></textarea>
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <button class="btn btn-primary btn-sm" type="submit">{{ 'Add comment'|trans }}</button>
                    <span class="text-muted small">{{ 'Will be saved together with the order.'|trans }}</span>
                </div>
            </form>
        </div>
    </div>

    <template data-draft-order-comments-target="prototype">
        {{ include('admin/order/_draft_comment_item.html.twig', {
            field_name: form.draftComments.vars.prototype.vars.full_name,
            body: '',
            order_form_id: order_form_id
        }) }}
    </template>
</div>
