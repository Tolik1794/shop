{% if value is not empty %}
    <button
            type="button"
            class="btn btn-link btn-sm order-icon-action"
            data-copy-text="{{ value|e('html_attr') }}"
            onclick="event.stopPropagation(); navigator.clipboard.writeText(this.dataset.copyText)"
            title="{{ title|default('admin.common.copy'|trans) }}"
            aria-label="{{ title|default('admin.common.copy'|trans) }}"
    >
        <i class="fa-regular fa-copy"></i>
    </button>
{% endif %}
