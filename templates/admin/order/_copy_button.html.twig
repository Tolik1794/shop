{% if value is not empty %}
    {% set feedback_message = feedback|default('Copied'|trans) %}
    <button
            type="button"
            class="btn btn-link btn-sm order-icon-action order-copy-action"
            data-controller="clipboard"
            data-clipboard-text-value="{{ value|e('html_attr') }}"
            data-clipboard-message-value="{{ feedback_message|e('html_attr') }}"
            data-action="click->clipboard#copy"
            title="{{ title|default('admin.common.copy'|trans) }}"
            aria-label="{{ title|default('admin.common.copy'|trans) }}"
    >
        <i class="fa-regular fa-copy"></i>
        {% if label|default(null) %}
            <span>{{ label }}</span>
        {% endif %}
    </button>
{% endif %}
