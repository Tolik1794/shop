{% set empty_text = 'Not specified'|trans %}
{% set dash_text = '—' %}
{% set currency_code = entity.currency ? entity.currency.code : dash_text %}
{% set customer_name = entity.customerNameSnapshot|default('')|trim %}
{% set customer_phone = entity.customerPhoneSnapshot|default('')|trim %}
{% set customer_email = entity.customerEmailSnapshot|default('')|trim %}
{% set delivery_address = entity.deliveryAddress|default('')|trim %}
{% set payment_review = payment_review|default(null) %}

{% set primary_order_action %}
    {% if entity.status.value == 'draft' %}
        <form method="post"
              action="{{ path('app_admin_order_confirm', {store_id: app.request.attributes.get('store_id'), id: entity.id}) }}"
              class="d-inline" data-action="submit->reload-card#submitQuickAction">
            <input type="hidden" name="_token" value="{{ csrf_token('confirm_order_' ~ entity.id) }}">
            <button class="btn btn-success btn-sm"
                    type="submit" {{ entity.orderEntries|length == 0 ? 'disabled' : '' }}>{{ 'admin.order.actions.confirm'|trans }}</button>
        </form>
    {% endif %}

    {% if can_ship|default(false) %}
        <form method="post"
              action="{{ path('app_admin_order_ship', {store_id: app.request.attributes.get('store_id'), id: entity.id}) }}"
              class="d-inline">
            <input type="hidden" name="_token" value="{{ csrf_token('ship_order_' ~ entity.id) }}">
            <button class="btn btn-success btn-sm" type="submit"><i
                        class="fa-solid fa-truck me-1"></i>{{ 'admin.order.actions.ship'|trans }}</button>
        </form>
    {% endif %}

    {% if entity.status.value == 'shipped' %}
        <form method="post"
              action="{{ path('app_admin_order_mark_delivered', {store_id: app.request.attributes.get('store_id'), id: entity.id}) }}"
              class="d-inline" data-action="submit->reload-card#submitQuickAction">
            <input type="hidden" name="_token" value="{{ csrf_token('mark_delivered_order_' ~ entity.id) }}">
            <button class="btn btn-success btn-sm"
                    type="submit">{{ 'admin.order.actions.mark_delivered'|trans }}</button>
        </form>
    {% endif %}

    {% if entity.status.value == 'delivered' %}
        <form method="post"
              action="{{ path('app_admin_order_complete', {store_id: app.request.attributes.get('store_id'), id: entity.id}) }}"
              class="d-inline" data-action="submit->reload-card#submitQuickAction"
              data-confirm-message="{{ 'admin.order.confirm.complete'|trans }}">
            <input type="hidden" name="_token" value="{{ csrf_token('complete_order_' ~ entity.id) }}">
            <button class="btn btn-success btn-sm" type="submit">{{ 'admin.order.actions.complete'|trans }}</button>
        </form>
    {% endif %}
{% endset %}

{% set secondary_order_actions %}
    {% set rollback_target_status = rollback_target_status|default(null) %}
    {% set return_to_draft_duplicates_rollback = can_rollback_status|default(false) and rollback_target_status == 'draft' %}

    {% if entity.status.value == 'draft' %}
        <a class="dropdown-item"
           href="{{ path('app_admin_order_edit', query_params|default({})|merge({store_id: app.request.attributes.get('store_id'), id: entity.id})) }}">
            <i class="fa-solid fa-pen me-1"></i>{{ 'admin.common.edit'|trans }}
        </a>
    {% endif %}

    {% if entity.status.value in ['confirmed', 'awaiting_stock', 'ready_to_ship'] and not return_to_draft_duplicates_rollback %}
        <form method="post"
              action="{{ path('app_admin_order_return_to_draft', {store_id: app.request.attributes.get('store_id'), id: entity.id}) }}"
              class="m-0" data-action="submit->reload-card#submitQuickAction"
              data-confirm-message="{{ 'admin.order.confirm.return_to_draft'|trans }}">
            <input type="hidden" name="_token" value="{{ csrf_token('return_to_draft_order_' ~ entity.id) }}">
            <button class="dropdown-item"
                    type="submit">{{ 'admin.order.actions.return_to_draft'|trans }}</button>
        </form>
    {% endif %}

    {% if can_rollback_status|default(false) %}
        <form method="post"
              action="{{ path('app_admin_order_rollback_status', {store_id: app.request.attributes.get('store_id'), id: entity.id}) }}"
              class="m-0" data-action="submit->reload-card#submitQuickAction"
              data-confirm-message="{{ 'admin.order.confirm.rollback_status'|trans }}">
            <input type="hidden" name="_token" value="{{ csrf_token('rollback_status_order_' ~ entity.id) }}">
            <button class="dropdown-item"
                    type="submit">{{ 'admin.order.actions.rollback_status'|trans }}</button>
        </form>
    {% endif %}

    {% if entity.status.value not in ['canceled', 'completed'] %}
        <form method="post"
              action="{{ path('app_admin_order_cancel', {store_id: app.request.attributes.get('store_id'), id: entity.id}) }}"
              class="m-0" data-action="submit->reload-card#submitQuickAction"
              data-confirm-message="{{ 'admin.order.confirm.cancel'|trans }}">
            <input type="hidden" name="_token" value="{{ csrf_token('cancel_order_' ~ entity.id) }}">
            <button class="dropdown-item text-danger" type="submit">{{ 'admin.order.actions.cancel'|trans }}</button>
        </form>
    {% endif %}
{% endset %}
{% set show_more_actions = secondary_order_actions|trim or not primary_order_action|trim %}
{% set header_badges %}
    {{ include('admin/_components/status/_badge.html.twig', {context: 'order', value: entity.status.value}) }}
    {{ include('admin/_components/status/_badge.html.twig', {context: 'payment', value: entity.paymentStatus.value}) }}
{% endset %}

<div class="card show-card order-show-card" {{ stimulus_target('reload-card', 'card') }} data-card-id="{{ entity.id }}">
    {{ include('admin/_components/show_card/_header.html.twig', {
        title: entity.number,
        subtitle: customer_name,
        badges: header_badges,
        primary_action: primary_order_action,
        secondary_actions: secondary_order_actions,
        show_more: show_more_actions
    }) }}
    <div class="card-body">
        <div class="order-show-grid">
            <section class="order-show-section">
                <h6>{{ 'admin.order.sections.customer'|trans }}</h6>
                <dl class="order-show-fields">
                    <div>
                        <dt>{{ 'admin.order.fields.customer'|trans }}</dt>
                        <dd>{{ customer_name is not empty ? customer_name : empty_text }}</dd>
                    </div>
                    <div>
                        <dt>{{ 'admin.common.phone'|trans }}</dt>
                        <dd class="order-show-copyable">
                            {% if customer_phone is not empty %}
                                <span>{{ customer_phone }}</span>
                                {{ include('admin/order/_copy_button.html.twig', {
                                    value: customer_phone,
                                    title: 'admin.order.customer.copy_phone'|trans
                                }) }}
                            {% else %}
                                {{ empty_text }}
                            {% endif %}
                        </dd>
                    </div>
                    <div>
                        <dt>{{ 'admin.common.email'|trans }}</dt>
                        <dd>{{ customer_email is not empty ? customer_email : empty_text }}</dd>
                    </div>
                    {% if entity.customer and entity.customer.labels|length > 0 %}
                        <div>
                            <dt>{{ 'admin.customer.fields.labels'|trans }}</dt>
                            <dd>{{ include('admin/_components/customer/_labels.html.twig', {labels: entity.customer.labels}) }}</dd>
                        </div>
                    {% endif %}
                </dl>
            </section>

            <section class="order-show-section">
                <h6>{{ 'admin.order.fields.payment'|trans }}</h6>
                {% if payment_review %}
                    <div class="alert alert-warning py-2 mb-3">
                        <div class="fw-semibold">{{ 'Canceled order still has received payment.'|trans }}</div>
                        <div class="small">{{ 'Review refund with accounting before closing the financial process.'|trans }}</div>
                        <div class="small mt-1">{{ 'Net paid amount'|trans }}: {{ payment_review.paidAmountBase|money }}</div>
                    </div>
                {% endif %}
                <dl class="order-show-money-list">
                    <div>
                        <dt>{{ 'admin.common.total'|trans }}</dt>
                        <dd>{{ entity.totalAmount|money }} {{ currency_code }}</dd>
                    </div>
                    <div>
                        <dt>{{ 'admin.order.fields.discount'|trans }}</dt>
                        <dd>{{ entity.discountAmount is not null ? entity.discountAmount|money ~ ' ' ~ currency_code : dash_text }}</dd>
                    </div>
                    <div>
                        <dt>{{ 'admin.order.fields.paid_amount_base'|trans }}</dt>
                        <dd>{{ entity.paidAmountBase|money }}</dd>
                    </div>
                    <div>
                        <dt>{{ 'admin.order.fields.paid_at'|trans }}</dt>
                        <dd>{{ entity.paidAt ? entity.paidAt|date('d.m.Y H:i') : dash_text }}</dd>
                    </div>
                    <div class="text-muted">
                        <dt>{{ 'admin.common.currency'|trans }}</dt>
                        <dd>{{ currency_code }}</dd>
                    </div>
                    <div class="text-muted">
                        <dt>{{ 'admin.order.fields.exchange_rate'|trans }}</dt>
                        <dd>{{ entity.exchangeRateToBase ?: dash_text }}</dd>
                    </div>
                    <div class="text-muted">
                        <dt>{{ 'admin.order.fields.total_base'|trans }}</dt>
                        <dd>{{ entity.totalAmountBase|money }}</dd>
                    </div>
                </dl>
            </section>

            <section class="order-show-section">
                <h6>{{ 'admin.order.sections.delivery'|trans }}</h6>
                <p class="mb-0">{{ delivery_address is not empty ? delivery_address : empty_text }}</p>
            </section>

            <section class="order-show-section order-show-section-wide">
                <h6>{{ 'admin.order.sections.products'|trans }}</h6>
                {% if entity.orderEntries|length > 0 %}
                    <div class="order-show-products">
                        {% for entry in entity.orderEntries %}
                            {% set modal_id = 'order-product-details-' ~ entity.id ~ '-' ~ entry.id %}
                            {% set product_name = entry.productNameSnapshot|default('')|trim %}
                            {% set product_code = entry.productCodeSnapshot|default('')|trim %}
                            {% set unit_code = entry.unitCodeSnapshot|default('')|trim %}
                            {% set quantity_label = entry.quantity|quantity(entry.product) ~ (unit_code is not empty ? ' ' ~ unit_code : '') %}
                            {% set product_copy_text = (product_name is not empty ? product_name : empty_text) ~ '\n' ~ ('admin.common.quantity'|trans) ~ ': ' ~ quantity_label %}
                            <div class="order-show-product-card">
                                <div class="order-show-product-main">
                                    <div class="order-show-product-heading order-show-copyable">
                                        <strong class="order-show-product-name">{{ product_name is not empty ? product_name : empty_text }}</strong>
                                        <button
                                                type="button"
                                                class="btn btn-link btn-sm order-icon-action order-show-product-action"
                                                data-bs-toggle="modal"
                                                data-bs-target="#{{ modal_id }}"
                                                title="{{ 'admin.order.actions.open_product'|trans }}"
                                                aria-label="{{ 'admin.order.actions.open_product'|trans }}"
                                        >
                                            <i class="fa-solid fa-circle-info"></i>
                                        </button>
                                        {% if product_name is not empty %}
                                            {{ include('admin/order/_copy_button.html.twig', {
                                                value: product_copy_text,
                                                title: 'admin.order.product.copy_name'|trans,
                                                feedback: 'Copied'|trans
                                            }) }}
                                            <span class="order-copy-feedback" data-copy-feedback aria-live="polite"></span>
                                        {% endif %}
                                    </div>
                                    <div class="text-muted small order-show-product-meta">
                                        <span>{{ quantity_label }}</span>
                                        <span class="mx-1">·</span>
                                        <span class="order-show-product-total">{{ entry.totalPrice|money }} {{ currency_code }}</span>
                                    </div>
                                    {% if product_code is not empty %}
                                        <div class="text-muted small">{{ product_code }}</div>
                                    {% endif %}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                    {% for entry in entity.orderEntries %}
                        {% set modal_id = 'order-product-details-' ~ entity.id ~ '-' ~ entry.id %}
                        {{ include('admin/order/_product_details_modal.html.twig', {entry: entry, entity: entity, modal_id: modal_id}) }}
                    {% endfor %}
                {% else %}
                    <p class="text-muted mb-0">{{ 'admin.order.empty.products'|trans }}</p>
                {% endif %}
            </section>

            <section class="order-show-section">
                <h6>{{ 'admin.order.sections.inventory_documents'|trans }}</h6>
                {% if entity.inventoryDocuments|length > 0 %}
                    <div class="order-show-documents">
                        {% for inventoryDocument in entity.inventoryDocuments %}
                            <div class="order-show-document">
                                <div>
                                    <a href="{{ path('app_admin_inventory_document_index', {store_id: app.request.attributes.get('store_id'), id: inventoryDocument.id}) }}">
                                        {{ inventoryDocument.number }}
                                    </a>
                                    <div class="text-muted small">
                                        {{ inventoryDocument.documentDate|date('d.m.Y') }} · {{ inventoryDocument.type.value }}
                                    </div>
                                </div>
                                {{ include('admin/_components/status/_badge.html.twig', {context: 'inventory', value: inventoryDocument.status.value}) }}
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <p class="text-muted mb-0">{{ dash_text }}</p>
                {% endif %}
            </section>
        </div>
    </div>
</div>
