<h5 class="card-title mb-3">Comments</h5>
<div class="order-discussion-scroll-frame">
    <div class="order-discussion-scroll order-discussion-comments">
        {% set current_comment_date = null %}
        {% for comment in comments %}
            {% set comment_date = comment.createdAt|date('Y-m-d') %}
            {% if comment_date != current_comment_date %}
                {% set current_comment_date = comment_date %}
                <div class="text-muted small fw-semibold mt-3 mb-2">{{ comment.createdAt|date('Y-m-d') }}</div>
            {% endif %}
            <div class="border-start ps-3 mb-3" data-order-discussion-comment>
                <div class="d-flex justify-content-between align-items-start gap-2">
                    <div>
                        <strong>{{ comment.author }}</strong>
                        {% if comment.updatedAt %}
                            <span class="text-muted small">· edited</span>
                        {% endif %}
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="text-muted small">{{ comment.createdAt|date('H:i') }}</span>
                        <button
                                type="button"
                                class="btn btn-link btn-sm p-0 text-muted"
                                title="Edit comment"
                                aria-label="Edit comment"
                                data-action="click->order-discussion#toggleEdit"
                        >
                            <i class="fa-solid fa-pen"></i>
                        </button>
                        <form
                                method="post"
                                action="{{ path('app_admin_order_comment_delete', {store_id: app.request.attributes.get('store_id'), id: entity.id, commentId: comment.id}) }}"
                                class="d-inline"
                                data-action="submit->order-discussion#submit"
                                data-confirm="Delete comment?"
                        >
                            <input type="hidden" name="_token" value="{{ csrf_token('delete_order_comment_' ~ comment.id) }}">
                            <button class="btn btn-link btn-sm p-0 text-danger" type="submit" title="Delete comment" aria-label="Delete comment">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        </form>
                    </div>
                </div>
                <div>{{ comment.body|nl2br }}</div>
                <form
                        method="post"
                        action="{{ path('app_admin_order_comment_edit', {store_id: app.request.attributes.get('store_id'), id: entity.id, commentId: comment.id}) }}"
                        class="d-none mt-2"
                        data-action="submit->order-discussion#submit"
                        data-order-discussion-target="editForm"
                >
                    <input type="hidden" name="_token" value="{{ csrf_token('edit_order_comment_' ~ comment.id) }}">
                    <textarea name="body" class="form-control form-control-sm mb-2" rows="2" required>{{ comment.body }}</textarea>
                    <div class="d-flex gap-2">
                        <button class="btn btn-light btn-sm" type="submit">Save edit</button>
                        <button class="btn btn-link btn-sm" type="button" data-action="click->order-discussion#toggleEdit">Cancel</button>
                    </div>
                </form>
            </div>
        {% else %}
            <p class="text-muted mb-0">No comments.</p>
        {% endfor %}
    </div>
</div>

<form method="post" action="{{ path('app_admin_order_comment_add', {store_id: app.request.attributes.get('store_id'), id: entity.id}) }}" class="mt-3" data-action="submit->order-discussion#submit">
    <input type="hidden" name="_token" value="{{ csrf_token('add_order_comment_' ~ entity.id) }}">
    <label for="order-comment-body-{{ entity.id }}" class="form-label">Add comment</label>
    <textarea id="order-comment-body-{{ entity.id }}" name="body" class="form-control mb-2" rows="3" required></textarea>
    <button class="btn btn-primary btn-sm" type="submit">Add comment</button>
</form>
