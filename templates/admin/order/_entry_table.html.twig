<div class="card order-entries-card">
    <div class="card-header">
        <h5 class="card-title mb-0">{{ 'admin.order.sections.entries'|trans }}</h5>
    </div>
    <div class="card-body">
        {{ include('admin/order/_product_search.html.twig') }}

        {% if form.orderEntries.vars.errors|length > 0 %}
            <div class="form-error">
                {{ form_errors(form.orderEntries) }}
            </div>
        {% endif %}

        <div class="order-entry-list" data-order-form-target="entries">
            {% for entry in form.orderEntries %}
                {{ include('admin/order/_entry_row.html.twig', {entry: entry, currency: form.currency.vars.data|default(null)}) }}
            {% endfor %}
        </div>
        <div class="order-entries-empty text-center text-muted {{ form.orderEntries|length > 0 ? 'd-none' : '' }}" data-order-form-target="emptyState">
            <i class="fa-solid fa-box-open order-entries-empty__icon"></i>
            <div class="order-entries-empty__title">{{ 'admin.order.empty.entries'|trans }}</div>
            <div class="order-entries-empty__hint small">{{ 'admin.order.empty.entries_hint'|trans }}</div>
        </div>
    </div>
</div>
