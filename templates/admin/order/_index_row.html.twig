<tr
		id="{{ entity.id }}"
		data-id-column="id"
		class="{{ first_entity and entity.id == first_entity.id ? 'table-active' : '' }}"
		data-action="click->reload-card#reloadOrderCards click->reload-card#tableActivate"
		data-show-link="{{ path('app_admin_order_show', {store_id: app.request.attributes.get('store_id'), id: entity.id}) }}"
		data-comments-link="{{ path('app_admin_order_comments', {store_id: app.request.attributes.get('store_id'), id: entity.id}) }}"
		data-customer-history-link="{{ path('app_admin_order_customer_history', {store_id: app.request.attributes.get('store_id'), id: entity.id}) }}"
		data-history-link="{{ path('app_admin_order_history', {store_id: app.request.attributes.get('store_id'), id: entity.id}) }}"
		data-payments-link="{{ path('app_admin_payment_order_document', {store_id: app.request.attributes.get('store_id'), order_id: entity.id}) }}"
		data-payment-complete="{{ entity.paymentStatus.value in ['paid', 'overpaid'] ? '1' : '0' }}"
>
	<td>
		{% set entry_count = entity.orderEntries|length %}
		{% set unread_count = (unread_comment_counts|default({}))[entity.id]|default(0) %}
		{% set badges %}
			{% if unread_count > 0 %}
				<span class="badge rounded-pill bg-danger order-comment-unread-badge" title="{{ 'Unread comments'|trans }}" data-order-comment-unread>
					<i class="fa-solid fa-comment-dots me-1"></i>{{ unread_count }}
				</span>
			{% endif %}
			{{ include('admin/_components/status/_badge.html.twig', {context: 'order', value: entity.status.value}) }}
			{{ include('admin/_components/status/_badge.html.twig', {context: 'payment', value: entity.paymentStatus.value}) }}
		{% endset %}
		{% set items %}
			{% for entry in entity.orderEntries %}
				{% set has_discount = entry.discountAmount is not null and entry.discountAmount > 0 %}
				{{ include('admin/_components/document_list/_item.html.twig', {
					name: entry.productNameSnapshot,
					quantity_label: entry.quantity|quantity(entry.product),
					unit_amount: entry.unitPrice|money,
					discount_amount: entry.discountAmount|money,
					total_amount: entry.totalPrice|money ~ ' ' ~ entity.currency.code,
					show_calculation: has_discount,
					sku: entry.productCodeSnapshot
				}) }}
			{% endfor %}
		{% endset %}
		{{ include('admin/_components/document_list/_card.html.twig', {
			number: entity.number,
			subject: entity.customerNameSnapshot,
			total: entity.totalAmount|money ~ ' ' ~ entity.currency.code,
			badges: badges,
			item_count: entry_count,
			items_title: 'admin.document_list.products_count'|trans({'%count%': entry_count}),
			items: items,
			empty_text: 'No items'|trans
		}) }}
	</td>
</tr>
