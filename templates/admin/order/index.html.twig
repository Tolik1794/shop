{% extends 'admin/_store_components/layout.html.twig' %}

{% block title %}Orders{% endblock %}

{% set table_actions %}
    {% if is_granted('order.create') %}
        <a class="btn btn-light btn-sm" href="{{ path('app_admin_order_new', {store_id: app.request.attributes.get('store_id')}) }}"><i class="fa-solid fa-plus me-1"></i>{{ 'New'|trans }}</a>
    {% endif %}
{% endset %}

{% set table_head %}
{% endset %}

{% set table_body %}
    {% for entity in pagination %}
        {{ include('admin/order/_index_row.html.twig', {
            entity: entity,
            first_entity: first_entity,
            unread_comment_counts: unread_comment_counts|default({})
        }) }}
    {% endfor %}
{% endset %}

{% set order_filter_params = app.request.query.all(filter_form.vars.name) %}
{% set active_order_filters = {} %}
{% for filter_name, filter_value in order_filter_params %}
    {% if filter_value is not iterable and filter_value is not same as('') and filter_value is not null %}
        {% set active_order_filters = active_order_filters|merge({(filter_name): filter_value}) %}
    {% endif %}
{% endfor %}
{% set order_filter_labels = {
    number: 'Number'|trans,
    customer: 'Customer'|trans,
    status: 'Status'|trans
} %}
{% set order_filter_collapse_id = filter_form.vars.id ~ '-advanced-filters' %}
{% set order_filters_open = filter_form.vars.errors|length > 0 %}
{% set order_tab_keys = ['show', 'payments', 'comments', 'customer', 'history'] %}
{% set order_tab_key_map = {show: 0, payments: 1, comments: 2, customer: 3, history: 4} %}
{% set active_order_tab = app.request.query.get('active_tab')|default('show') %}
{% set active_order_tab_key = order_tab_key_map[active_order_tab]|default(0) %}

{% set order_list_controls %}
    <div class="order-list-toolbar">
        <div class="order-list-toolbar__row">
            <div class="order-list-toolbar__title">
                <h5 class="card-title mb-0">{{ 'Orders'|trans }}</h5>
                <span class="text-muted small">{{ 'admin.pagination.records'|trans({'%count%': pagination.getTotalItemCount}) }}</span>
            </div>
            <div class="order-list-toolbar__controls">
                <form class="order-list-toolbar__search" method="get" action="{{ path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')) }}">
                    {% for filter_name, filter_value in active_order_filters %}
                        {% if filter_name != 'number' %}
                            <input type="hidden" name="{{ filter_form.vars.full_name }}[{{ filter_name }}]" value="{{ filter_value }}">
                        {% endif %}
                    {% endfor %}
                    <label class="visually-hidden" for="order-quick-search">{{ 'admin.order.filters.quick_search'|trans }}</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text"><i class="fa-solid fa-magnifying-glass"></i></span>
                        <input id="order-quick-search"
                               class="form-control"
                               type="search"
                               name="{{ filter_form.number.vars.full_name }}"
                               value="{{ filter_form.number.vars.value|default('') }}"
                               placeholder="{{ 'admin.order.filters.quick_search_placeholder'|trans }}">
                    </div>
                </form>
                <button class="btn btn-light btn-sm"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#{{ order_filter_collapse_id }}"
                        aria-expanded="{{ order_filters_open ? 'true' : 'false' }}"
                        aria-controls="{{ order_filter_collapse_id }}">
                    <i class="fa-solid fa-filter me-1"></i>{{ 'admin.common.filters'|trans }}
                    {% if active_order_filters %}
                        <span class="badge bg-danger ms-1">{{ active_order_filters|length }}</span>
                    {% endif %}
                </button>
                {{ table_actions }}
            </div>
        </div>

        {% if active_order_filters %}
            <div class="order-filter-chips" aria-label="{{ 'admin.order.filters.active_filters'|trans }}">
                {% for filter_name, filter_value in active_order_filters %}
                    {% set filter_label = order_filter_labels[filter_name]|default(filter_name|replace({'_': ' '})|capitalize) %}
                    {% set filter_display_value = filter_name == 'status' ? filter_value|replace({'_': ' '})|title : filter_value %}
                    {% set next_filter_params = order_filter_params|merge({(filter_name): ''}) %}
                    <a class="order-filter-chip"
                       href="{{ path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')|merge({(filter_form.vars.name): next_filter_params})) }}"
                       aria-label="{{ 'admin.order.filters.clear_filter'|trans({'%label%': filter_label}) }}">
                        <span>{{ filter_label }}: {{ filter_display_value }}</span>
                        <i class="fa-solid fa-xmark"></i>
                    </a>
                {% endfor %}
                <a class="order-filter-chip order-filter-chip--reset"
                   href="{{ path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')) }}">
                    {{ 'admin.common.reset_filters'|trans }}
                </a>
            </div>
        {% endif %}

        {{ include('admin/_components/filter/_accordion_panel.html.twig', {
            form: filter_form,
            collapse_id: order_filter_collapse_id,
            is_open: order_filters_open
        }) }}
    </div>
{% endset %}

{% block main_content %}
    <main class="content" {{ stimulus_controller('reload-card') }}>
        <div class="container-fluid p-0">
            {{ include('admin/_components/_quick_action_flashes.html.twig') }}

            <div class="row">
                <div class="col-xxl-5 col-xl-5 col-lg-6">
                    {{ include('admin/_components/card/_tab_card.html.twig', {
                        active_tab_key: active_order_tab_key,
                        tab_keys: order_tab_keys,
                        tab_head: [
                            include('admin/_components/tab_icon/_show.html.twig'),
                            include('admin/_components/tab_icon/_payment.html.twig', {
                                is_paid: first_entity and first_entity.paymentStatus.value in ['paid', 'overpaid']
                            }),
                            include('admin/_components/tab_icon/_comments.html.twig'),
                            include('admin/_components/tab_icon/_customer.html.twig'),
                            include('admin/_components/tab_icon/_history.html.twig')
                        ],
                        tab_body: [
                            first_entity ? render(controller(
                                'App\\Controller\\Admin\\OrderController::show',
                                { store_id: app.request.attributes.get('store_id'), id: first_entity.id, 'request': app.request }
                            )) : '<div class="card"><div class="card-body">' ~ 'Nothing to show...'|trans ~ '</div></div>',
                            first_entity ? render(controller(
                                'App\\Controller\\Admin\\PaymentController::orderDocument',
                                { store_id: app.request.attributes.get('store_id'), order_id: first_entity.id, 'request': app.request }
                            )) : '<div class="card"><div class="card-body">' ~ 'Nothing to show...'|trans ~ '</div></div>',
                            first_entity ? render(controller(
                                'App\\Controller\\Admin\\OrderController::comments',
                                { store_id: app.request.attributes.get('store_id'), id: first_entity.id }
                            )) : '<div class="card"><div class="card-body">' ~ 'Nothing to show...'|trans ~ '</div></div>',
                            first_entity ? render(controller(
                                'App\\Controller\\Admin\\OrderController::customerHistory',
                                { store_id: app.request.attributes.get('store_id'), id: first_entity.id }
                            )) : '<div class="card"><div class="card-body">' ~ 'Nothing to show...'|trans ~ '</div></div>',
                            first_entity ? render(controller(
                                'App\\Controller\\Admin\\OrderController::history',
                                { store_id: app.request.attributes.get('store_id'), id: first_entity.id }
                            )) : '<div class="card"><div class="card-body">' ~ 'Nothing to show...'|trans ~ '</div></div>'
                        ]
                    }) }}
                </div>
                <div class="col-xxl-7 col-xl-7 col-lg-6">
                    {{ include('admin/_components/card/_table_card.html.twig', {
                        table_title: 'Orders',
                        table_class: 'document-list-table order-index-table',
                        table_head: table_head,
                        table_body: table_body,
                        filter_form: null,
                        show_header: false,
                        before_table: order_list_controls
                    }) }}
                </div>
            </div>
        </div>
    </main>
{% endblock %}
