<div class="border-start ps-3 mb-3" data-draft-order-comments-item>
    <input
            type="hidden"
            name="{{ field_name }}"
            value="{{ body }}"
            form="{{ order_form_id }}"
            data-draft-order-comments-field
    >
    <div class="d-flex justify-content-between align-items-start gap-2">
        <div>
            <strong>{{ app.user }}</strong>
            <span class="text-muted small">· {{ 'not saved yet'|trans }}</span>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button
                    type="button"
                    class="btn btn-link btn-sm p-0 text-muted"
                    title="{{ 'Edit comment'|trans }}"
                    aria-label="{{ 'Edit comment'|trans }}"
                    data-action="click->draft-order-comments#toggleEdit"
            >
                <i class="fa-solid fa-pen"></i>
            </button>
            <button
                    type="button"
                    class="btn btn-link btn-sm p-0 text-danger"
                    title="{{ 'Delete comment'|trans }}"
                    aria-label="{{ 'Delete comment'|trans }}"
                    data-confirm="Delete comment?"
                    data-action="click->draft-order-comments#remove"
            >
                <i class="fa-solid fa-trash"></i>
            </button>
        </div>
    </div>
    <div class="order-draft-comment-body" data-draft-order-comments-body>{{ body }}</div>
    <form class="d-none mt-2" data-action="submit->draft-order-comments#saveEdit" data-draft-order-comments-edit-form>
        <textarea class="form-control form-control-sm mb-2" rows="2" required data-draft-order-comments-edit-body>{{ body }}</textarea>
        <div class="d-flex gap-2">
            <button class="btn btn-light btn-sm" type="submit">{{ 'Save edit'|trans }}</button>
            <button class="btn btn-link btn-sm" type="button" data-action="click->draft-order-comments#toggleEdit">{{ 'Cancel'|trans }}</button>
        </div>
    </form>
</div>
