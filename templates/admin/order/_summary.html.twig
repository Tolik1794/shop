<div class="card order-summary" data-order-form-target="summary">
    <div class="card-header">
        <h5 class="card-title mb-0">Підсумки</h5>
        <span class="text-muted small d-none" data-order-form-target="summaryStatus">Перерахунок...</span>
    </div>
    <div class="card-body">
        <div class="order-summary-grid">
            <div class="order-summary-item">
                <span>Кількість позицій</span>
                <strong data-order-form-target="summaryCount">0</strong>
            </div>
            <div class="order-summary-item">
                <span>Сума товарів</span>
                <strong data-order-form-target="summarySubtotal">0.00</strong>
            </div>
            <div class="order-summary-item">
                <span>Знижка</span>
                <strong data-order-form-target="summaryDiscount">0.00</strong>
            </div>
            <div class="order-summary-item order-summary-total">
                <span>Загальна сума</span>
                <strong data-order-form-target="summaryTotal">0.00</strong>
            </div>
        </div>
    </div>
</div>
