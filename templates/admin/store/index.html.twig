{% extends 'admin/layout.html.twig' %}

{% block title %}Store list{% endblock %}

{% block navbar_breadcrumb %}
    {% set page_breadcrumb %}
    {{ include('admin/_components/_resource_breadcrumb.html.twig', {
        section_label: 'Stores',
        section_url: path('admin_store_index'),
        current_label: first_entity ? first_entity.name : ''
    }) }}
    {% endset %}
    {{ include('admin/_components/_navbar_header.html.twig', {title: 'Stores'|trans, breadcrumb: page_breadcrumb}) }}
{% endblock %}

{% set table_actions %}
    {% if is_granted('store.create') %}
        <a class="btn btn-light btn-sm" href="{{ path('admin_store_new') }}"><i class="fa-solid fa-plus me-1"></i>{{ 'New'|trans }}</a>
    {% endif %}
{% endset %}

{% set table_head %}
    <tr>
        <th>{{ 'Name'|trans }}</th>
        <th>{{ 'Phone'|trans }}</th>
        <th>{{ 'Status'|trans }}</th>
    </tr>
{% endset %}

{% set table_body %}
    {% for entity in pagination %}
        <tr
                id="{{ entity.id }}"
                data-id-column="store_id"
                class="{{ entity.id == first_entity.id ? 'table-active' : '' }}"
                data-action="click->reload-card#reloadCard click->reload-card#tableActivate"
                data-link="{{ path('admin_store_show', {store_id: entity.id}) }}"
                data-breadcrumb-label="{{ entity.name }}"
                onclick="document.getElementById('first-tab').click()"
        >
            <td>{{ entity.name }}</td>
            <td>{{ entity.phone }}</td>
            <td>
                <span class="badge {{ entity.status|active_status_class }}">{{ entity.status.value|capitalize }}</span>
            </td>
        </tr>
    {% endfor %}
{% endset %}

{% block main_content %}
    <main class="content" {{ stimulus_controller('reload-card') }}>
        <div class="container-fluid p-0">
            <div class="row">
                <div class="col-12 col-xl-5 col-lg-5">
                    {{ include('admin/_components/card/_tab_card.html.twig', {
                        tab_head: [
                            include('admin/_components/tab_icon/_show.html.twig'),
                        ],
                        tab_body: [
                            first_entity ? render(controller(
                                'App\\Controller\\Admin\\StoreController::show',
                                { 'store_id': first_entity.id, 'request': app.request }
                            )) : '<div class="card"><div class="card-body">' ~ 'Nothing to show...'|trans ~ '</div></div>',
                        ]
                    }) }}
                </div>
                <div class="col-12 col-xl-7 col-lg-7 order-first">
                    {{ include('admin/_components/card/_table_card.html.twig', {
                        actions: table_actions,
                        table_title: 'Stores',
                        table_head: table_head,
                        table_body: table_body,
                        filter_form: filter_form
                    }) }}
                </div>
            </div>
        </div>
    </main>
{% endblock %}
