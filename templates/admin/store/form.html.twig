{% extends 'admin/layout.html.twig' %}

{% block title %}Hello MainController!{% endblock %}

{% block main_content %}
    <main class="content">
        <div class="container-fluid p-0">
            {{ form_start(form) }}
            <div class="row">
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title mb-0">{{ 'Private info'|trans }}</h5>
                    </div>
                    <div class="card-body">
                        {% if avatar %}
                            <img alt="Avatar" class="article-img" src="{{ avatar|trim_full_path|imagine_filter('squared_thumbnail_small') }}">
                        {% endif %}
                        {{ form_errors(form) }}

                        {% for name, widget in form %}
                            <div class="mb-2">
                                {% set widget_type = widget.vars.block_prefixes|first %}
                                {% if widget_type != 'button' %}
                                    {% if name != '_token' %}
                                        <div class="font-weight-bold">
                                            {{ form_label(widget, null, {label_attr: {class: 'form-label'}}) }}
                                        </div>
                                    {% endif %}

                                    {{ form_widget(widget, {attr:{class: 'form-control'}}) }}

                                    <small>{{ form_help(widget) }}</small>

                                    {% if widget.vars.errors|length > 0 %}
                                        <div class="form-error">
                                            {{ form_errors(widget) }}
                                        </div>
                                    {% endif %}
                                {% endif %}
                            </div>
                        {% endfor %}

                    </div>
                </div>
                {{ include('admin/_components/_form_actions.html.twig', {
                    cancel_url: path('admin_store_index', app.request.query.all|merge(app.request.attributes.get('_route_params')))
                }) }}
            </div>
            {{ form_end(form, {'render_rest': false}) }}
        </div>
    </main>
{% endblock %}
