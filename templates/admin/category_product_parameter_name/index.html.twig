{% set table_actions %}
    {% if is_granted('category_parameter.manage') %}
        <a class="btn btn-light btn-sm" href="{{ path('admin_category_product_parameter_name_new',
            {
                store_id: store.id,
                category_id: category.id
            }
        ) }}"><i class="fa-solid fa-plus me-1"></i>{{ 'New'|trans }}</a>
    {% endif %}
{% endset %}

{% set table_head %}
    <tr>
        <th>{{ 'Name'|trans }}</th>
        <th>{{ 'Is filter'|trans }}</th>
        <th>{{ 'Is required'|trans }}</th>
        <th>{{ 'Category'|trans }}</th>
        <th>{{ 'Actions'|trans }}</th>
    </tr>
{% endset %}

{% set table_body %}
    {% for entity in pagination %}
        {% set item_actions %}
            <a class="btn btn-light btn-sm" href="{{ path('admin_category_product_parameter_name_edit',
                {
                    store_id: store.id,
                    category_id: category.id,
                    parameter_name_id: entity.id
                }
            ) }}"><i class="fa-solid fa-pen me-1"></i>{{ 'Edit'|trans }}</a>
            <form
                    method="post"
                    action="{{ path('admin_category_product_parameter_name_delete',
                        {
                            store_id: store.id,
                            category_id: category.id,
                            parameter_name_id: entity.id
                        }
                    ) }}"
                    onsubmit="return confirm('Are you sure you want to delete this item?');"
                    class="d-inline"
            >
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ entity.id) }}">
                <button class="btn btn-light btn-sm text-danger" type="submit">
                    <i class="fa-solid fa-trash me-1"></i>Delete
                </button>
            </form>
        {% endset %}

        <tr
                class="{{ entity.category == category ?: 'table-secondary' }}"
        >
            <td>{{ entity.productParameterName }}</td>
            <td>{{ entity.isFilter }}</td>
            <td>{{ entity.isRequired }}</td>
            <td>{{ entity.category.name }}</td>
            {% if entity.category == category %}
                <td>{{ include('admin/_components/card/_actions.html.twig', {actions: item_actions}) }}</td>
            {% else %}
                <td></td>
            {% endif %}
        </tr>
    {% endfor %}
{% endset %}

<div class="col">
    {{ include('admin/_components/card/_table_card.html.twig', {
        actions: table_actions,
        table_title: 'Category product parameter names',
        table_head: table_head,
        table_body: table_body
    }) }}
</div>
