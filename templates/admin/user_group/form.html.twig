{% extends 'admin/layout.html.twig' %}

{% block title %}User group{% endblock %}

{% block navbar_breadcrumb %}
    {{ include('admin/_components/_resource_breadcrumb.html.twig', {
        section_label: 'User groups',
        section_url: path('admin_user_group_index'),
        current_label: entity is defined and entity.id ? entity.name : 'New'
    }) }}
{% endblock %}

{% block main_content %}
    <main class="content">
        <div class="container-fluid p-0">
            {{ form_start(form) }}
            <div class="row">
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title mb-0">{{ 'User group'|trans }}</h5>
                    </div>
                    <div class="card-body">
                        {{ form_errors(form) }}

                        {{ include('admin/_components/_form_widgets.html.twig', {form: form}) }}

                    </div>
                </div>
                {{ include('admin/_components/_form_actions.html.twig', {
                    cancel_url: path('admin_user_group_index')
                }) }}
            </div>
            {{ form_end(form, {'render_rest': false}) }}
        </div>
    </main>
{% endblock %}
