{% extends 'admin/layout.html.twig' %}

{% block title %}User groups{% endblock %}

{% block navbar_breadcrumb %}
    {% set page_breadcrumb %}
    {{ include('admin/_components/_resource_breadcrumb.html.twig', {
        section_label: 'User groups'
    }) }}
    {% endset %}
    {{ include('admin/_components/_navbar_header.html.twig', {title: 'User groups'|trans, breadcrumb: page_breadcrumb}) }}
{% endblock %}

{% block main_content %}
    <main class="content">
        <div class="container-fluid p-0">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h5 class="card-title mb-0">{{ 'User groups'|trans }}</h5>
                            {% if is_granted('rbac.manage') %}
                                <a class="btn btn-light btn-sm" href="{{ path('admin_user_group_new') }}"><i class="fa-solid fa-plus me-1"></i>{{ 'New'|trans }}</a>
                            {% endif %}
                        </div>
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead>
                                <tr>
                                    <th>{{ 'Name'|trans }}</th>
                                    <th>{{ 'Code'|trans }}</th>
                                    <th>{{ 'Permissions'|trans }}</th>
                                    <th></th>
                                </tr>
                                </thead>
                                <tbody>
                                {% for group in groups %}
                                    <tr>
                                        <td>
                                            {{ group.name }}
                                            {% if group.system %}
                                                <span class="badge bg-light text-dark ms-1">{{ 'System'|trans }}</span>
                                            {% endif %}
                                        </td>
                                        <td><code>{{ group.code }}</code></td>
                                        <td>{{ group.permissions|length }}</td>
                                        <td class="text-end">
                                            {% if is_granted('rbac.manage') %}
                                                <a class="btn btn-light btn-sm" href="{{ path('admin_user_group_edit', {id: group.id}) }}">{{ 'Edit'|trans }}</a>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="4">{{ 'Nothing to show...'|trans }}</td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
{% endblock %}
