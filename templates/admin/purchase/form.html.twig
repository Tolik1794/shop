{% extends 'admin/_store_components/layout.html.twig' %}

{% block title %}{{ 'admin.menu.purchases'|trans }}{% endblock %}

{% block navbar_breadcrumb %}
	{% set page_breadcrumb %}
		{{ include('admin/_components/_resource_breadcrumb.html.twig', {
			section_label: 'admin.menu.purchases'|trans,
			section_url: entity.id
				? path('app_admin_purchase_index', {store_id: app.request.attributes.get('store_id'), id: entity.id, page: purchase_index_page})
				: path('app_admin_purchase_index', {store_id: app.request.attributes.get('store_id')}),
			current_label: entity.id ? entity.number : 'admin.common.new'|trans
		}) }}
	{% endset %}
	{{ include('admin/_components/_navbar_header.html.twig', {
		title: entity.id ? 'admin.purchase.title.edit'|trans : 'admin.purchase.title.new'|trans,
		subtitle: entity.number,
		breadcrumb: page_breadcrumb
	}) }}
{% endblock %}

{% block main_content %}
	<main class="content" {{ stimulus_controller('purchase-form select-two') }}>
		<div class="container-fluid p-0">
			{% if form.vars.errors|length > 0 %}
				<div class="form-error mb-3">
					{{ form_errors(form) }}
				</div>
			{% endif %}

			{{ form_start(form, {attr: {id: 'purchase-form', 'data-select-two-target': 'form'}}) }}
				<div class="row g-3">
					<div class="col-12 col-xl-4">
						<div class="card">
							<div class="card-header">
								<h5 class="card-title mb-0">{{ 'admin.purchase.sections.general'|trans }}</h5>
							</div>
							<div class="card-body">
								{{ form_row(form.supplier) }}
								{{ form_row(form.currency) }}
								{{ form_row(form.invoiceNumber) }}
								{{ form_row(form.documentDate) }}
								{{ form_row(form.deliveryCost) }}
								{{ form_row(form.comment) }}
							</div>
						</div>
					</div>

					<div class="col-12 col-xl-8">
						<div class="card">
							<div class="card-header d-flex justify-content-between align-items-center">
								<h5 class="card-title mb-0">{{ 'admin.purchase.sections.entries'|trans }}</h5>
								<button type="button" class="btn btn-light btn-sm" data-action="purchase-form#addEntry">
									<i class="fa-solid fa-plus me-1"></i>{{ 'admin.purchase.actions.add_entry'|trans }}
								</button>
							</div>
							<div class="card-body">
								{% if form.purchaseEntries.vars.errors|length > 0 %}
									<div class="form-error">
										{{ form_errors(form.purchaseEntries) }}
									</div>
								{% endif %}

								<div data-purchase-form-target="entries">
									{% for entry in form.purchaseEntries %}
										{{ include('admin/purchase/_entry_row.html.twig', {entry: entry, currency: form.currency.vars.data|default(null)}) }}
									{% endfor %}
								</div>

								<div class="text-muted {{ form.purchaseEntries|length > 0 ? 'd-none' : '' }}" data-purchase-form-target="emptyState">
									{{ 'admin.order.empty.entries'|trans }}
								</div>

								<template data-purchase-form-target="prototype">
									{{ include('admin/purchase/_entry_row.html.twig', {entry: form.purchaseEntries.vars.prototype, currency: form.currency.vars.data|default(null)}) }}
								</template>
							</div>
						</div>

						{% if entity.id %}
							<div class="card mt-3">
								<div class="card-header">
									<h5 class="card-title mb-0">{{ 'admin.purchase.sections.summary'|trans }}</h5>
								</div>
								<div class="card-body">
									<div>{{ 'Total'|trans }}: <strong>{{ entity.totalAmount|money }} {{ entity.currency.code }}</strong></div>
									<div>{{ 'Total base'|trans }}: <strong>{{ entity.totalAmountBase|money }}</strong></div>
									<div>{{ 'Delivery'|trans }}: <strong>{{ entity.deliveryCost|money }} {{ entity.currency.code }}</strong></div>
								</div>
							</div>
						{% endif %}
					</div>
				</div>

				{% if form._token is defined %}
					{{ form_widget(form.version) }}
					{{ form_widget(form._token) }}
				{% endif %}

				{{ include('admin/_components/_form_actions.html.twig', {
					cancel_url: path('app_admin_purchase_index', app.request.query.all|merge({store_id: app.request.attributes.get('store_id'), id: entity.id, page: purchase_index_page})),
					context: entity.number
				}) }}
			{{ form_end(form, {'render_rest': false}) }}
		</div>
	</main>
{% endblock %}
