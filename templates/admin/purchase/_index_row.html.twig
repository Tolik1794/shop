<tr
		id="{{ entity.id }}"
		data-id-column="id"
		class="{{ first_entity and entity.id == first_entity.id ? 'table-active' : '' }}"
		data-action="click->reload-card#reloadDocumentCards click->reload-card#tableActivate"
		data-show-link="{{ path('app_admin_purchase_show', {store_id: app.request.attributes.get('store_id'), id: entity.id}) }}"
		data-payments-link="{{ path('app_admin_payment_purchase_document', {store_id: app.request.attributes.get('store_id'), purchase_id: entity.id}) }}"
		data-payment-complete="{{ entity.paymentStatus.value in ['paid', 'overpaid'] ? '1' : '0' }}"
>
	<td>
		<table class="table table-sm mb-2">
			<thead>
			<tr>
				<th>Number</th>
				<th>Supplier</th>
				<th>Status</th>
				<th>Total</th>
				<th>Payment</th>
			</tr>
			</thead>
			<tbody>
			<tr>
				<td><strong>{{ entity.number }}</strong></td>
				<td><strong>{{ entity.supplierNameSnapshot }}</strong></td>
				<td>{{ entity.status.value }}</td>
				<td><strong>{{ entity.totalAmount|money }} {{ entity.currency.code }}</strong></td>
				<td>{{ entity.paymentStatus.value }}</td>
			</tr>
			</tbody>
		</table>

		{% if entity.purchaseEntries|length > 0 %}
			<table class="table table-sm mb-0">
				<thead>
				<tr>
					<th>Product</th>
					<th>Qty</th>
					<th>Unit</th>
					<th>Unit cost</th>
					<th>Total</th>
				</tr>
				</thead>
				<tbody>
				{% for entry in entity.purchaseEntries %}
					<tr>
						<td>
							<strong>{{ entry.productNameSnapshot }}</strong>
							{% if entry.productCodeSnapshot %}
								<div class="text-muted small">{{ entry.productCodeSnapshot }}</div>
							{% endif %}
						</td>
						<td>{{ entry.quantity|number_format(2, '.', '') }}</td>
						<td>{{ entry.unitCodeSnapshot }}</td>
						<td>{{ entry.unitCost|money }}</td>
						<td><strong>{{ entry.totalCost|money }} {{ entity.currency.code }}</strong></td>
					</tr>
				{% endfor %}
				</tbody>
			</table>
		{% else %}
			<span class="text-muted small">No items</span>
		{% endif %}
	</td>
</tr>
