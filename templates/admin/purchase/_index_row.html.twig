<tr
		id="{{ entity.id }}"
		data-id-column="id"
		class="{{ first_entity and entity.id == first_entity.id ? 'table-active' : '' }}"
		data-action="click->reload-card#reloadDocumentCards click->reload-card#tableActivate"
		data-show-link="{{ path('app_admin_purchase_show', {store_id: app.request.attributes.get('store_id'), id: entity.id}) }}"
		data-payments-link="{{ path('app_admin_payment_purchase_document', {store_id: app.request.attributes.get('store_id'), purchase_id: entity.id}) }}"
		data-history-link="{{ path('app_admin_purchase_history', {store_id: app.request.attributes.get('store_id'), id: entity.id}) }}"
		data-payment-complete="{{ entity.paymentStatus.value in ['paid', 'overpaid'] ? '1' : '0' }}"
		data-breadcrumb-label="{{ entity.number }}"
>
	<td>
		{% set entry_count = entity.purchaseEntries|length %}
		{% set badges %}
			{{ include('admin/_components/status/_badge.html.twig', {context: 'purchase', value: entity.status.value}) }}
			{{ include('admin/_components/status/_badge.html.twig', {context: 'payment', value: entity.paymentStatus.value}) }}
		{% endset %}
		{% set items %}
			{% for entry in entity.purchaseEntries %}
				{{ include('admin/_components/document_list/_item.html.twig', {
					name: entry.productNameSnapshot,
					quantity_label: entry.quantity|quantity(entry.product) ~ (entry.unitCodeSnapshot ? ' ' ~ entry.unitCodeSnapshot : ''),
					total_amount: entry.totalCost|money ~ ' ' ~ entity.currency.code,
					sku: entry.productCodeSnapshot
				}) }}
			{% endfor %}
		{% endset %}
		{{ include('admin/_components/document_list/_card.html.twig', {
			number: entity.number,
			subject: entity.supplierNameSnapshot,
			total: entity.totalAmount|money ~ ' ' ~ entity.currency.code,
			badges: badges,
			item_count: entry_count,
			items_title: 'admin.document_list.products_count'|trans({'%count%': entry_count}),
			items: items,
			empty_text: 'No items'|trans
		}) }}
	</td>
</tr>
