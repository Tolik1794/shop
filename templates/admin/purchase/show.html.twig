{% set actions %}
	{% if entity.status.value == 'draft' %}
		<a class="btn btn-light btn-sm" href="{{ path('app_admin_purchase_edit', query_params|merge({store_id: app.request.attributes.get('store_id'), id: entity.id})) }}"><i class="fa-solid fa-pen me-1"></i>{{ 'Edit'|trans }}</a>
	{% endif %}
{% endset %}

<div class="card" {{ stimulus_target('reload-card', 'card') }} data-card-id="{{ entity.id }}">
	<div class="card-header">
		{% if actions|trim %}
			{{ include('admin/_components/card/_actions.html.twig', {actions: actions}) }}
		{% endif %}
		<h5 class="card-title mb-0">{{ entity.number }}</h5>
	</div>
	<div class="card-body">
		<table class="table table-sm mt-2 mb-4">
			<tbody>
			<tr><th>{{ 'Status'|trans }}</th><td>{{ entity.status.value }}</td></tr>
			<tr><th>{{ 'Supplier'|trans }}</th><td>{{ entity.supplierNameSnapshot }}</td></tr>
			<tr><th>{{ 'Phone'|trans }}</th><td>{{ entity.supplierPhoneSnapshot }}</td></tr>
			<tr><th>{{ 'Email'|trans }}</th><td>{{ entity.supplierEmailSnapshot }}</td></tr>
			<tr><th>{{ 'Currency'|trans }}</th><td>{{ entity.currency.code }}</td></tr>
			<tr><th>{{ 'Exchange rate'|trans }}</th><td>{{ entity.exchangeRateToBase }}</td></tr>
			<tr><th>{{ 'Invoice'|trans }}</th><td>{{ entity.invoiceNumber }}</td></tr>
			<tr><th>{{ 'Document date'|trans }}</th><td>{{ entity.documentDate ? entity.documentDate|date('Y-m-d') : '' }}</td></tr>
			<tr><th>{{ 'Delivery'|trans }}</th><td>{{ entity.deliveryCost|money }} {{ entity.currency.code }}</td></tr>
			<tr><th>{{ 'Total'|trans }}</th><td>{{ entity.totalAmount|money }} {{ entity.currency.code }}</td></tr>
			<tr><th>{{ 'Total base'|trans }}</th><td>{{ entity.totalAmountBase|money }}</td></tr>
			<tr><th>{{ 'Payment'|trans }}</th><td>{{ entity.paymentStatus.value }}</td></tr>
			<tr><th>{{ 'Paid amount base'|trans }}</th><td>{{ entity.paidAmountBase|money }}</td></tr>
			<tr><th>{{ 'Paid at'|trans }}</th><td>{{ entity.paidAt ? entity.paidAt|date('Y-m-d H:i') : '' }}</td></tr>
			<tr><th>{{ 'Comment'|trans }}</th><td>{{ entity.comment }}</td></tr>
			</tbody>
		</table>

		<h6 class="mb-2">{{ 'Products'|trans }}</h6>
		{% if entity.purchaseEntries|length > 0 %}
			<div class="table-responsive">
				<table class="table table-sm mb-3">
					<thead>
					<tr>
						<th>{{ 'Product'|trans }}</th>
						<th>{{ 'Warehouse'|trans }}</th>
						<th>{{ 'Qty'|trans }}</th>
						<th>{{ 'Unit'|trans }}</th>
						<th>{{ 'Unit cost'|trans }}</th>
						<th>{{ 'Delivery'|trans }}</th>
						<th>{{ 'Total'|trans }}</th>
					</tr>
					</thead>
					<tbody>
					{% for entry in entity.purchaseEntries %}
						<tr>
							<td>
								{{ entry.productNameSnapshot }}
								<div class="text-muted small">{{ entry.productCodeSnapshot }}</div>
							</td>
							<td>{{ entry.warehouse.name }}</td>
							<td>{{ entry.quantity|quantity(entry.product) }}</td>
							<td>{{ entry.unitCodeSnapshot }}</td>
							<td>{{ entry.unitCost|money }}</td>
							<td>{{ entry.deliveryCost|money }}</td>
							<td>{{ entry.totalCost|money }}</td>
						</tr>
					{% endfor %}
					</tbody>
				</table>
			</div>
		{% else %}
			<p class="text-muted">{{ 'No products.'|trans }}</p>
		{% endif %}

		{% if entity.inventoryDocuments|length > 0 %}
			<h6 class="mb-2">{{ 'Inventory documents'|trans }}</h6>
			<div class="table-responsive">
				<table class="table table-sm mb-3">
					<thead>
					<tr>
						<th>{{ 'Date'|trans }}</th>
						<th>{{ 'Number'|trans }}</th>
						<th>{{ 'Type'|trans }}</th>
						<th>{{ 'Status'|trans }}</th>
					</tr>
					</thead>
					<tbody>
					{% for inventoryDocument in entity.inventoryDocuments %}
						<tr>
							<td>{{ inventoryDocument.documentDate|date('Y-m-d') }}</td>
							<td>
								<a href="{{ path('app_admin_inventory_document_index', {store_id: app.request.attributes.get('store_id'), id: inventoryDocument.id}) }}">
									{{ inventoryDocument.number }}
								</a>
							</td>
							<td>{{ inventoryDocument.type.value }}</td>
							<td>{{ inventoryDocument.status.value }}</td>
						</tr>
					{% endfor %}
					</tbody>
				</table>
			</div>
		{% endif %}

		{% if entity.status.value == 'draft' %}
			<form method="post" action="{{ path('app_admin_purchase_order', {store_id: app.request.attributes.get('store_id'), id: entity.id}) }}" class="d-inline" data-action="submit->reload-card#submitQuickAction">
				<input type="hidden" name="_token" value="{{ csrf_token('order_purchase_' ~ entity.id) }}">
				<button class="btn btn-success btn-sm" type="submit" {{ entity.purchaseEntries|length == 0 ? 'disabled' : '' }}>{{ 'Order'|trans }}</button>
			</form>
		{% endif %}

		{% if entity.status.value == 'ordered' %}
			<form method="post" action="{{ path('app_admin_purchase_return_to_draft', {store_id: app.request.attributes.get('store_id'), id: entity.id}) }}" class="d-inline" data-action="submit->reload-card#submitQuickAction" data-confirm-message="{{ 'Return purchase to draft?'|trans }}">
				<input type="hidden" name="_token" value="{{ csrf_token('return_to_draft_purchase_' ~ entity.id) }}">
				<button class="btn btn-light btn-sm" type="submit">{{ 'Return to draft'|trans }}</button>
			</form>
		{% endif %}

		{% if can_receive|default(false) %}
			<form method="post" action="{{ path('app_admin_purchase_receive', {store_id: app.request.attributes.get('store_id'), id: entity.id}) }}" class="d-inline">
				<input type="hidden" name="_token" value="{{ csrf_token('receive_purchase_' ~ entity.id) }}">
				<button class="btn btn-success btn-sm" type="submit"><i class="fa-solid fa-truck me-1"></i>{{ 'Receive'|trans }}</button>
			</form>
		{% endif %}

		{% if entity.status.value in ['draft', 'ordered'] %}
			<form method="post" action="{{ path('app_admin_purchase_cancel', {store_id: app.request.attributes.get('store_id'), id: entity.id}) }}" class="d-inline" data-action="submit->reload-card#submitQuickAction" data-confirm-message="{{ 'Cancel purchase?'|trans }}">
				<input type="hidden" name="_token" value="{{ csrf_token('cancel_purchase_' ~ entity.id) }}">
				<button class="btn btn-danger btn-sm" type="submit">{{ 'Cancel'|trans }}</button>
			</form>
		{% endif %}

		{% if entity.status.value == 'received' %}
			<form method="post" action="{{ path('app_admin_purchase_complete', {store_id: app.request.attributes.get('store_id'), id: entity.id}) }}" class="d-inline" data-action="submit->reload-card#submitQuickAction" data-confirm-message="{{ 'Complete purchase?'|trans }}">
				<input type="hidden" name="_token" value="{{ csrf_token('complete_purchase_' ~ entity.id) }}">
				<button class="btn btn-success btn-sm" type="submit">{{ 'Complete'|trans }}</button>
			</form>
		{% endif %}
	</div>
</div>
