{% set currencyCode = currency ? currency.code|default('') : '' %}

<div class="purchase-entry border rounded mb-2 {{ not entry.vars.valid ? 'border-danger' : '' }}" data-purchase-form-target="row">
	<button type="button" class="btn btn-sm purchase-entry__remove" data-action="purchase-form#removeEntry"
			title="{{ 'admin.common.delete'|trans }}" aria-label="{{ 'admin.common.delete'|trans }}">
		<i class="fa-solid fa-trash"></i>
	</button>

	<div class="purchase-entry__fields">
		<div class="purchase-entry__top-row">
			<div class="purchase-entry__field purchase-entry__field--product">
				{{ form_row(entry.product, {attr: {
					'data-purchase-form-target': 'product',
					'data-action': 'change->purchase-form#recalculate'
				}}) }}
			</div>
			<div class="purchase-entry__field purchase-entry__field--warehouse">
				{{ form_row(entry.warehouse, {attr: {
					'data-purchase-form-target': 'warehouse',
					'data-action': 'change->purchase-form#recalculate'
				}}) }}
			</div>
		</div>
		<div class="purchase-entry__numbers-row">
			<div class="purchase-entry__field purchase-entry__field--number purchase-entry__field--quantity">
				{{ form_row(entry.quantity, {attr: {
					class: 'form-control-sm',
					'data-purchase-form-target': 'quantity',
					'data-action': 'input->purchase-form#recalculate'
				}}) }}
			</div>
			<div class="purchase-entry__field purchase-entry__field--number purchase-entry__field--unit-cost">
				{{ form_row(entry.unitCost, {label: 'admin.purchase.fields.unit_cost_short', help: currencyCode ~ ' / ' ~ 'admin.purchase.fields.per_unit'|trans, attr: {
					class: 'form-control-sm',
					'data-purchase-form-target': 'unitCost',
					'data-action': 'input->purchase-form#recalculate'
				}}) }}
			</div>
			<div class="purchase-entry__field purchase-entry__field--number purchase-entry__field--sale-price">
				{{ form_row(entry.salePrice, {help: currencyCode ~ ' / ' ~ 'admin.purchase.fields.per_unit'|trans, attr: {
					class: 'form-control-sm',
					'data-purchase-form-target': 'salePrice',
					'data-action': 'input->purchase-form#recalculate'
				}}) }}
			</div>
		</div>
	</div>

	<div class="purchase-entry__summary" data-purchase-form-target="rowSummary">
		<span>{{ 'admin.purchase.summary.purchase_total'|trans }}: <strong data-purchase-form-target="rowPurchaseTotal">0.00</strong> <span data-purchase-currency-label>{{ currencyCode }}</span></span>
		<span>{{ 'admin.purchase.summary.potential_sale'|trans }}: <strong data-purchase-form-target="rowSaleTotal">-</strong> <span data-purchase-currency-label>{{ currencyCode }}</span></span>
		<span>{{ 'admin.purchase.summary.margin'|trans }}: <strong data-purchase-form-target="rowMargin">-</strong> <span data-purchase-currency-label>{{ currencyCode }}</span> <span data-purchase-form-target="rowMarginPercent"></span></span>
		<span class="text-warning d-none" data-purchase-form-target="belowCostWarning">
			<i class="fa-solid fa-triangle-exclamation me-1"></i>{{ 'admin.purchase.validation.sale_below_cost'|trans }}
		</span>
	</div>

	{% if entry.vars.errors|length > 0 %}
		<div class="form-error purchase-entry__errors">
			{{ form_errors(entry) }}
		</div>
	{% endif %}
</div>
