{% set entryData = entry.vars.data|default(null) %}
{% set product = entryData ? entryData.product|default(null) : null %}
{% set currencyCode = currency ? currency.code|default('') : '' %}
{% set hasEntryErrors =
	entry.vars.errors|length > 0
	or entry.product.vars.errors|length > 0
	or entry.warehouse.vars.errors|length > 0
	or entry.quantity.vars.errors|length > 0
	or entry.unitCost.vars.errors|length > 0
	or entry.salePrice.vars.errors|length > 0
%}

<div class="border rounded p-3 mb-3 position-relative {{ not entry.vars.valid ? 'border-danger' : '' }}" data-purchase-form-target="row">
	<button type="button" class="btn btn-sm btn-outline-danger position-absolute top-0 end-0 mt-2 me-2" data-action="purchase-form#removeEntry">
		<i class="fa-solid fa-trash"></i>
	</button>

	<div class="row g-3 pe-5">
		<div class="col-12 col-lg-4">
			{{ form_row(entry.product) }}
		</div>
		<div class="col-12 col-lg-3">
			{{ form_row(entry.warehouse) }}
		</div>
		<div class="col-6 col-lg-2">
			{{ form_row(entry.quantity) }}
		</div>
		<div class="col-6 col-lg-3">
			{{ form_row(entry.unitCost, {help: currencyCode}) }}
		</div>
		<div class="col-6 col-lg-3">
			{{ form_row(entry.salePrice, {help: currencyCode}) }}
		</div>
		{% if entryData and entryData.id %}
			<div class="col-6 col-lg-3">
				<label class="form-label">Allocated delivery</label>
				<div class="form-control-plaintext">{{ entryData.deliveryCost|money }} {{ currencyCode }}</div>
			</div>
			<div class="col-6 col-lg-3">
				<label class="form-label">Total cost</label>
				<div class="form-control-plaintext fw-bold">{{ entryData.totalCost|money }} {{ currencyCode }}</div>
			</div>
		{% endif %}
	</div>

	{% if hasEntryErrors %}
		<div class="form-error mt-3 mb-0">
			{{ form_errors(entry) }}
			{{ form_errors(entry.product) }}
			{{ form_errors(entry.warehouse) }}
			{{ form_errors(entry.quantity) }}
			{{ form_errors(entry.unitCost) }}
			{{ form_errors(entry.salePrice) }}
		</div>
	{% endif %}
</div>
