{% extends 'admin/_store_components/layout.html.twig' %}

{% block title %}Exchange rate{% endblock %}

{% block main_content %}
    <main class="content">
        <div class="container-fluid p-0">
            <div class="row">
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title mb-0">{{ 'Exchange rate'|trans }}</h5>
                    </div>
                    <div class="card-body">
                        {{ form_start(form) }}
                        {% if form.vars.errors|length > 0 %}
                            <div class="form-error">
                                {{ form_errors(form) }}
                            </div>
                        {% endif %}

                        {% for name, widget in form %}
                            {{ form_row(widget) }}
                        {% endfor %}

                        <div class="row">
                            <div class="form-control-lg">
                                <button type="submit" class="btn btn-primary btn mb-1 me-2">{{ 'admin.common.save'|trans }}</button>
                                <button name="save" value="stay" type="submit" class="btn btn-primary mb-1 me-2">{{ 'admin.common.save_and_continue'|trans }}</button>
                                <a href="{{ path('app_admin_exchange_rate_index', app.request.query.all|merge(app.request.attributes.get('_route_params'))) }}" class="btn btn-text mb-1">{{ 'admin.common.cancel'|trans }}</a>
                            </div>
                        </div>

                        {{ form_end(form, {'render_rest': false}) }}
                    </div>
                </div>
            </div>
        </div>
    </main>
{% endblock %}
