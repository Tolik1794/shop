{% set actions %}
    {% if entity.store %}
        <a class="btn btn-light btn-sm" href="{{ path('app_admin_exchange_rate_edit', query_params|merge({store_id: app.request.attributes.get('store_id'), id: entity.id})) }}"><i class="fa-solid fa-pen me-1"></i>{{ 'Edit'|trans }}</a>
    {% endif %}
{% endset %}

<div class="card" {{ stimulus_target('reload-card', 'card') }} data-card-id="{{ entity.id }}">
    <div class="card-header">
        {% if actions|trim %}
            {{ include('admin/_components/card/_actions.html.twig', {actions: actions}) }}
        {% endif %}
        <h5 class="card-title mb-0">{{ entity.fromCurrency.code }} > {{ entity.toCurrency.code }}</h5>
    </div>
    <div class="card-body">
        <table class="table table-sm mt-2 mb-4">
            <tbody>
            <tr>
                <th>{{ 'From'|trans }}</th>
                <td>{{ entity.fromCurrency.code }}</td>
            </tr>
            <tr>
                <th>{{ 'To'|trans }}</th>
                <td>{{ entity.toCurrency.code }}</td>
            </tr>
            <tr>
                <th>{{ 'Rate'|trans }}</th>
                <td>{{ entity.rate }}</td>
            </tr>
            <tr>
                <th>{{ 'Valid from'|trans }}</th>
                <td>{{ entity.validFrom|date('Y-m-d H:i') }}</td>
            </tr>
            <tr>
                <th>{{ 'Valid to'|trans }}</th>
                <td>{{ entity.validTo ? entity.validTo|date('Y-m-d H:i') : '' }}</td>
            </tr>
            <tr>
                <th>{{ 'Scope'|trans }}</th>
                <td>{{ entity.store ? entity.store.name : 'Global' }}</td>
            </tr>
            <tr>
                <th>{{ 'Source'|trans }}</th>
                <td>{{ entity.source }}</td>
            </tr>
            <tr>
                <th>{{ 'Comment'|trans }}</th>
                <td>{{ entity.comment }}</td>
            </tr>
            </tbody>
        </table>
    </div>
</div>
