{% set actions %}
	<a class="btn btn-light btn-sm" href="{{ path('app_admin_production_recipe_edit', query_params|merge({store_id: app.request.attributes.get('store_id'), id: entity.id})) }}"><i class="fa-solid fa-pen me-1"></i>Edit</a>
	<a class="btn btn-light btn-sm" href="{{ path('app_admin_production_order_new', {store_id: app.request.attributes.get('store_id'), recipe_id: entity.id}) }}"><i class="fa-solid fa-plus me-1"></i>Order</a>
{% endset %}

<div class="card" {{ stimulus_target('reload-card', 'card') }} data-card-id="{{ entity.id }}">
	<div class="card-header">
		{{ include('admin/_components/card/_actions.html.twig', {actions: actions}) }}
		<h5 class="card-title mb-0">{{ entity.name }}</h5>
	</div>
	<div class="card-body">
		<table class="table table-sm mt-2 mb-4">
			<tbody>
			<tr><th>Product</th><td>{{ entity.product.name }}</td></tr>
			<tr><th>Product code</th><td>{{ entity.product.code }}</td></tr>
			<tr><th>Default</th><td>{{ entity.default ? 'Yes' : 'No' }}</td></tr>
			<tr><th>Status</th><td>{{ entity.status.value }}</td></tr>
			<tr><th>Updated</th><td>{{ entity.updatedAt|date('Y-m-d H:i') }}</td></tr>
			</tbody>
		</table>

		<h6 class="mb-2">Materials</h6>
		{% if entity.items|length > 0 %}
			<div class="table-responsive">
				<table class="table table-sm mb-0">
					<thead>
					<tr>
						<th>Material</th>
						<th>Code</th>
						<th>Quantity</th>
						<th>Waste %</th>
					</tr>
					</thead>
					<tbody>
					{% for item in entity.items %}
						<tr>
							<td>{{ item.material.name }}</td>
							<td>{{ item.material.code }}</td>
							<td>{{ item.quantity }}</td>
							<td>{{ item.wastePercent }}</td>
						</tr>
					{% endfor %}
					</tbody>
				</table>
			</div>
		{% else %}
			<p class="text-muted">No materials.</p>
		{% endif %}
	</div>
</div>
