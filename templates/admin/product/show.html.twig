{% set actions %}
{#    {% if is_granted('POST_EDIT', entity) %}#}
        <a class="btn btn-light btn-sm" href="{{ path('admin_product_edit', query_params|merge({store_id: app.request.attributes.get('store_id'), id: entity.id})) }}"><i class="fa-solid fa-pen me-1"></i>Edit</a>
        <a class="btn btn-light btn-sm" href="{{ path('app_admin_product_price_index', {store_id: app.request.attributes.get('store_id'), product_id: entity.id}) }}"><i class="fa-solid fa-tags me-1"></i>Prices</a>
{#    {% endif %}#}
{% endset %}

<div class="card" {{ stimulus_target('reload-card', 'card') }} data-card-id="{{ entity.id }}">
    <div class="card-header">
        {% if actions|trim %}
            {{ include('admin/_components/card/_actions.html.twig', {actions: actions}) }}
        {% endif %}
        <h5 class="card-title mb-0">{{ entity.name }}</h5>
    </div>
    <div class="card-body">
        <div class="row g-0">
            <div class="col-sm-9 col-xl-12 col-xxl-9">
                <strong>Name</strong>
                <p>{{ entity.name }}</p>
            </div>
        </div>

        <table class="table table-sm mt-2 mb-4">
            <tbody>
            <tr>
                <th>Code</th>
                <td>{{ entity.code }}</td>
            </tr>
            <tr>
                <th>Category</th>
                <td>{{ entity.category }}</td>
            </tr>
            <tr>
                <th>Product kind</th>
                <td>{{ entity.productKind.value }}</td>
            </tr>
            <tr>
                <th>Unit</th>
                <td>{{ entity.unit.name }}</td>
            </tr>
            <tr>
                <th>Base sale price</th>
                <td>{{ entity.baseSalePrice|money }}</td>
            </tr>
            <tr>
                <th>Current price</th>
                <td>
                    {% if current_price %}
                        {{ current_price.price|money }} {{ current_price.currency.code }}
                    {% endif %}
                </td>
            </tr>
            <tr>
                <th>Prices</th>
                <td>
                    <a href="{{ path('app_admin_product_price_index', {store_id: app.request.attributes.get('store_id'), product_id: entity.id}) }}">Open</a>
                </td>
            </tr>
            <tr>
                <th>Can be sold</th>
                <td>{{ entity.canBeSold ? 'Yes' : 'No' }}</td>
            </tr>
            <tr>
                <th>Can be purchased</th>
                <td>{{ entity.canBePurchased ? 'Yes' : 'No' }}</td>
            </tr>
            <tr>
                <th>Can be manufactured</th>
                <td>{{ entity.canBeManufactured ? 'Yes' : 'No' }}</td>
            </tr>
            </tbody>
        </table>
    </div>
</div>
