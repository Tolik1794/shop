{% set actions %}
{#    {% if is_granted('product.manage') %}#}
        <a class="btn btn-light btn-sm" href="{{ path('admin_product_edit', query_params|merge({store_id: app.request.attributes.get('store_id'), id: entity.id})) }}"><i class="fa-solid fa-pen me-1"></i>{{ 'Edit'|trans }}</a>
        <a class="btn btn-light btn-sm" href="{{ path('app_admin_product_price_index', {store_id: app.request.attributes.get('store_id'), product_id: entity.id}) }}"><i class="fa-solid fa-tags me-1"></i>{{ 'Prices'|trans }}</a>
{#    {% endif %}#}
{% endset %}

<div class="card" {{ stimulus_target('reload-card', 'card') }} data-card-id="{{ entity.id }}">
    <div class="card-header">
        {% if actions|trim %}
            {{ include('admin/_components/card/_actions.html.twig', {actions: actions}) }}
        {% endif %}
        <h5 class="card-title mb-0">{{ entity.name }}</h5>
    </div>
    <div class="card-body">
        <div class="row g-0">
            <div class="col-sm-9 col-xl-12 col-xxl-9">
                <strong>{{ 'Name'|trans }}</strong>
                <p>{{ entity.name }}</p>
            </div>
        </div>

        <table class="table table-sm mt-2 mb-4">
            <tbody>
            <tr>
                <th>{{ 'Code'|trans }}</th>
                <td>{{ entity.code }}</td>
            </tr>
            <tr>
                <th>{{ 'Category'|trans }}</th>
                <td>{{ entity.category }}</td>
            </tr>
            <tr>
                <th>{{ 'Product kind'|trans }}</th>
                <td>{{ entity.productKind.value }}</td>
            </tr>
            <tr>
                <th>{{ 'Unit'|trans }}</th>
                <td>{{ entity.unit.name }}</td>
            </tr>
            <tr>
                <th>{{ 'Base sale price'|trans }}</th>
                <td>{{ entity.baseSalePrice|money }}</td>
            </tr>
            <tr>
                <th>{{ 'Current price'|trans }}</th>
                <td>
                    {% if current_price %}
                        {{ current_price.price|money }} {{ current_price.currency.code }}
                    {% endif %}
                </td>
            </tr>
            <tr>
                <th>{{ 'Prices'|trans }}</th>
                <td>
                    <a href="{{ path('app_admin_product_price_index', {store_id: app.request.attributes.get('store_id'), product_id: entity.id}) }}">{{ 'Open'|trans }}</a>
                </td>
            </tr>
            <tr>
                <th>{{ 'Can be sold'|trans }}</th>
                <td>{{ entity.canBeSold ? 'Yes' : 'No' }}</td>
            </tr>
            <tr>
                <th>{{ 'Can be purchased'|trans }}</th>
                <td>{{ entity.canBePurchased ? 'Yes' : 'No' }}</td>
            </tr>
            <tr>
                <th>{{ 'Can be manufactured'|trans }}</th>
                <td>{{ entity.canBeManufactured ? 'Yes' : 'No' }}</td>
            </tr>
            </tbody>
        </table>

        <h6 class="mb-2">{{ 'admin.product.relations.title'|trans }}</h6>
        {% if entity.productRelations|length == 0 %}
            <p class="text-muted small mb-0">{{ 'admin.product.relations.no_relations'|trans }}</p>
        {% else %}
            {% set relation_groups = {} %}
            {% for relation in entity.productRelations %}
                {% set type_key = relation.type.value %}
                {% set relation_groups = relation_groups|merge({(type_key): (relation_groups[type_key]|default([]))|merge([relation])}) %}
            {% endfor %}
            {% for type_key, group in relation_groups %}
                <div class="mb-2">
                    <div class="text-muted small text-uppercase">{{ ('admin.product.relation_type.' ~ type_key)|trans }}</div>
                    <ul class="list-unstyled mb-0">
                        {% for relation in group %}
                            {% set related = relation.relatedProduct %}
                            <li>
                                <a href="{{ path('admin_product_index', {store_id: app.request.attributes.get('store_id'), id: related.id}) }}">
                                    {{ related.name }}
                                </a>
                                <span class="text-muted">({{ related.code }})</span>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            {% endfor %}
        {% endif %}
    </div>
</div>
