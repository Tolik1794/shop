<div class="product-relation-row" {{ stimulus_target('product-relations', 'row') }}>
    <div class="product-relation-row__cell">
        {{ form_label(relation.relatedProduct, 'admin.product.relations.related_product'|trans, {label_attr: {class: 'form-label d-md-none'}}) }}
        {{ form_widget(relation.relatedProduct) }}
        {{ form_errors(relation.relatedProduct) }}
    </div>
    <div class="product-relation-row__cell">
        {{ form_label(relation.type, 'admin.product.relations.type'|trans, {label_attr: {class: 'form-label d-md-none'}}) }}
        {{ form_widget(relation.type, {attr: {class: 'form-select'}}) }}
        {{ form_errors(relation.type) }}
    </div>
    <div class="product-relation-row__action">
        <button type="button" class="btn btn-sm btn-outline-danger" data-action="product-relations#removeEntry" title="{{ 'admin.product.relations.remove'|trans }}" aria-label="{{ 'admin.product.relations.remove'|trans }}">
            <i class="fa-solid fa-trash"></i>
        </button>
    </div>
</div>
