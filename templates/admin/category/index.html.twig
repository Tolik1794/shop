{% extends 'admin/_store_components/layout.html.twig' %}

{% block title %}Category list{% endblock %}

{% block navbar_breadcrumb %}
    {% set page_breadcrumb %}
        {{ include('admin/_components/_resource_breadcrumb.html.twig', {
            section_label: 'Categories',
            section_url: path('admin_category_index', {store_id: app.request.attributes.get('store_id')}),
            current_label: first_entity ? first_entity.nameWithParent : ''
        }) }}
    {% endset %}
    {{ include('admin/_components/_navbar_header.html.twig', {
        title: 'Categories'|trans,
        subtitle: 'admin.category.index.subtitle'|trans,
        breadcrumb: page_breadcrumb
    }) }}
{% endblock %}

{% set create_action %}
    {% if is_granted('category.manage') %}
        <a class="btn btn-light btn-sm"
           href="{{ path('admin_category_new', {store_id: app.request.attributes.get('store_id')}) }}">
            <i class="fa-solid fa-plus me-1"></i>{{ 'admin.category.actions.new'|trans }}
        </a>
    {% endif %}
{% endset %}

{% set empty_detail %}
    <div class="card">
        <div class="card-body">
            {{ include('admin/_components/_empty_state.html.twig', {
                icon: 'fa-solid fa-folder-tree',
                title: 'admin.category.empty.title'|trans,
                text: 'admin.category.empty.text'|trans
            }) }}
        </div>
    </div>
{% endset %}

{% block main_content %}
    <main class="content" data-controller="reload-card category-tree">
        <div class="container-fluid p-0">
            <div class="row">
                <div class="col-12 col-xl-7 col-lg-7 order-first">
                    <div class="card category-tree-card">
                        <div class="card-header pb-0">
                            <div class="admin-index-toolbar">
                                <div class="admin-index-toolbar__title">
                                    <h5 class="card-title mb-0">{{ 'Categories'|trans }}</h5>
                                    <span class="text-muted small">{{ 'admin.pagination.records'|trans({'%count%': categories|length}) }}</span>
                                </div>
                                <div class="admin-index-toolbar__controls">
                                    <div class="admin-index-toolbar__search">
                                        <label class="index-search">
                                            <span class="visually-hidden">{{ 'admin.category.search.label'|trans }}</span>
                                            <span class="input-group input-group-sm">
                                                <span class="input-group-text"><i class="fa-solid fa-magnifying-glass"></i></span>
                                                <input type="search"
                                                       class="form-control"
                                                       placeholder="{{ 'admin.category.search.placeholder'|trans }}"
                                                       data-category-tree-target="search"
                                                       data-action="input->category-tree#search">
                                            </span>
                                        </label>
                                    </div>
                                    {{ create_action }}
                                </div>
                            </div>
                        </div>
                        <div class="card-body">
                            {% if categories %}
                                <div class="category-tree" role="tree">
                                    {{ include('admin/category/_tree_nodes.html.twig', {
                                        nodes: category_tree[0]|default([]),
                                        category_tree: category_tree,
                                        first_entity: first_entity,
                                        active_path_ids: active_path_ids,
                                        depth: 0
                                    }) }}
                                </div>
                                <div class="d-none" data-category-tree-target="empty">
                                    {{ include('admin/_components/_empty_state.html.twig', {
                                        icon: 'fa-solid fa-magnifying-glass',
                                        title: 'admin.common.no_results'|trans,
                                        text: 'admin.category.search.no_results'|trans
                                    }) }}
                                </div>
                            {% else %}
                                {{ include('admin/_components/_empty_state.html.twig', {
                                    icon: 'fa-solid fa-folder-tree',
                                    title: 'admin.category.empty.list_title'|trans,
                                    text: 'admin.category.empty.list_text'|trans,
                                    action: create_action
                                }) }}
                            {% endif %}
                        </div>
                    </div>
                </div>

                <div class="col-12 col-xl-5 col-lg-5">
                    {{ include('admin/_components/card/_tab_card.html.twig', {
                        tab_head: [
                            include('admin/_components/tab_icon/_show.html.twig')
                        ],
                        tab_body: [
                            first_entity ? render(controller(
                                'App\\Controller\\Admin\\CategoryController::show',
                                { store_id: app.request.attributes.get('store_id'), category: first_entity, 'request': app.request }
                            )) : empty_detail
                        ]
                    }) }}
                </div>
            </div>
        </div>
    </main>
{% endblock %}
