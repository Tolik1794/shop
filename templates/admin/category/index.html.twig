{% extends 'admin/_store_components/layout.html.twig' %}

{% block title %}Category list{% endblock %}

{% set category_filter_params = app.request.query.all(filter_form.vars.name) %}
{% set category_filter_collapse_id = filter_form.vars.id ~ '-filters' %}

{% set table_actions %}
    {% if is_granted('category.manage') %}
        <a class="btn btn-light btn-sm"
           href="{{ path('admin_category_new', {store_id: app.request.attributes.get('store_id')}) }}"><i class="fa-solid fa-plus me-1"></i>{{ 'New'|trans }}</a>
    {% endif %}
{% endset %}

{% set table_head %}
    <tr>
        <th>{{ 'Name'|trans }}</th>
    </tr>
{% endset %}

{% set table_body %}
    {% for entity in pagination %}
        <tr
                id="{{ entity.id }}"
                data-id-column="id"
                class="{{ entity.id == first_entity.id ? 'table-active' : '' }}"
                data-action="click->reload-card#reloadCard click->reload-card#tableActivate"
                data-link="{{ path('admin_category_show', {store_id: app.request.attributes.get('store_id'), category_id: entity.id}) }}"
                onclick="document.getElementById('first-tab').click()"
        >
            {% if entity.level > 0 %}
                <td class="{{ 'ps-'~(entity.level + 3) }}"><i class="fa-solid fa-angles-right"></i>{{ entity.name }}
                </td>
            {% else %}
                <td>{{ entity.name }}</td>
            {% endif %}
        </tr>
    {% endfor %}
{% endset %}

{% block main_content %}
    <main class="content" {{ stimulus_controller('reload-card') }}>
        <div class="container-fluid p-0">
            <div class="row">
                <div class="col-xxl-4 col-xl-5 col-lg-6">
                    {{ include('admin/_components/card/_tab_card.html.twig', {
                        tab_head: [
                            include('admin/_components/tab_icon/_show.html.twig')
                        ],
                        tab_body: [
                            first_entity ? render(controller(
                                'App\\Controller\\Admin\\CategoryController::show',
                                { store_id: app.request.attributes.get('store_id'), category: first_entity, 'request': app.request }
                            )) : '<div class="card"><div class="card-body">' ~ 'Nothing to show...'|trans ~ '</div></div>'
                        ]
                    }) }}
                </div>
                <div class="col-xxl-8 col-xl-7 col-lg-6">

                    <div class="card">
                        <div class="card-header pb-0">
                            {% set category_header_actions %}
                                <button class="btn btn-light btn-sm"
                                        type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#{{ category_filter_collapse_id }}"
                                        aria-expanded="{{ category_filter_params ? 'true' : 'false' }}"
                                        aria-controls="{{ category_filter_collapse_id }}">
                                    <i class="fa-solid fa-filter me-1"></i>{{ 'admin.common.filter'|trans }}
                                    {% if category_filter_params %}
                                        <span class="badge bg-danger ms-1">{{ category_filter_params|length }}</span>
                                    {% endif %}
                                </button>
                                {{ table_actions }}
                            {% endset %}
                            {% if category_header_actions|trim %}
                                {{ include('admin/_components/card/_actions.html.twig', {actions: category_header_actions}) }}
                            {% endif %}
                            <h5 class="card-title mb-0">{{ 'Categories'|trans }}</h5>
                        </div>
                        <div class="card-body">
                            {{ include('admin/_components/filter/_accordion_panel.html.twig', {
                                form: filter_form,
                                collapse_id: category_filter_collapse_id,
                                is_open: category_filter_params ? true : false
                            }) }}

                            {{ include('admin/_components/card/_collapse_table_card.html.twig', {
                                items: pagination,
                                first_entity: first_entity
                            }) }}

                            {{ include('admin/_components/pagination.html.twig', {pagination: pagination}) }}
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </main>
{% endblock %}
