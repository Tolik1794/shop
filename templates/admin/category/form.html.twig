{% extends 'admin/_store_components/layout.html.twig' %}

{% block title %}Hello MainController!{% endblock %}

{% block navbar_breadcrumb %}
    {{ include('admin/_components/_resource_breadcrumb.html.twig', {
        section_label: 'Categories',
        section_url: path('admin_category_index', {store_id: app.request.attributes.get('store_id')}),
        current_label: entity is defined and entity.id ? entity.name : 'New'
    }) }}
{% endblock %}

{% block main_content %}
    <main class="content">
        <div class="container-fluid p-0">
            {{ form_start(form) }}
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title mb-0">{{ entity is defined ? entity.name : 'New' }}</h5>
                    </div>
                    <div class="card-body">
                        {{ form_errors(form) }}

                        {% for name, widget in form %}
                            <div class="mb-2">
                                {% set widget_type = widget.vars.block_prefixes|first %}
                                {% if widget_type != 'button' %}
                                    {% if name != '_token' %}
                                        <div class="font-weight-bold">
                                            {{ form_label(widget, null, {label_attr: {class: 'form-label'}}) }}
                                        </div>
                                    {% endif %}

                                    {{ form_widget(widget, {attr: {class: (widget.vars.attr.class|default('') ~ ' form-control')|trim}}) }}

                                    <small>{{ form_help(widget) }}</small>

                                    {% if widget.vars.errors|length > 0 %}
                                        <div class="form-error">
                                            {{ form_errors(widget) }}
                                        </div>
                                    {% endif %}
                                {% endif %}
                            </div>
                        {% endfor %}

                    </div>
                </div>
                {{ include('admin/_components/_form_actions.html.twig', {
                    cancel_url: path('admin_category_index', app.request.query.all|merge(app.request.attributes.get('_route_params')))
                }) }}
            {{ form_end(form, {'render_rest': false}) }}

            {% if entity.id %}
                <div>
                    {{ render(controller(
                        'App\\Controller\\Admin\\CategoryProductParameterNameController::index',
                        {
                            store_id: app.request.attributes.get('store_id'),
                            category_id: entity.id,
                            request: app.request
                        }
                    )) }}
                </div>
            {% endif %}
        </div>
    </main>
{% endblock %}
