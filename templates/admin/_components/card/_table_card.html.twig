{% set card_filter_form = filter_form|default(null) %}
{% set card_filter_params = card_filter_form ? app.request.query.all(card_filter_form.vars.name) : {} %}
{% set card_filter_collapse_id = card_filter_form ? card_filter_form.vars.id ~ '-filters' : '' %}
{% set show_header = show_header|default(true) %}
{% set list_table = list_table|default(true) %}

{% set is_empty = pagination is defined and pagination|length == 0 %}

<div class="card">
    {% if show_header %}
        <div class="card-header pb-0">
            {# Universal index toolbar: title + record count on the left, search / filter /
               create / future actions on the right (orders-style). #}
            <div class="admin-index-toolbar">
                <div class="admin-index-toolbar__title">
                    {% if table_title|default('') %}
                        <h5 class="card-title mb-0">{{ table_title|trans }}</h5>
                    {% endif %}
                    {% if pagination is defined and pagination %}
                        <span class="text-muted small">{{ 'admin.pagination.records'|trans({'%count%': pagination.getTotalItemCount}) }}</span>
                    {% endif %}
                </div>
                <div class="admin-index-toolbar__controls">
                    {% if toolbar_search|default('')|trim %}
                        <div class="admin-index-toolbar__search">{{ toolbar_search|raw }}</div>
                    {% endif %}
                    {% if card_filter_form %}
                        <button class="btn btn-light btn-sm"
                                type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#{{ card_filter_collapse_id }}"
                                aria-expanded="{{ card_filter_params ? 'true' : 'false' }}"
                                aria-controls="{{ card_filter_collapse_id }}">
                            <i class="fa-solid fa-filter me-1"></i>{{ 'admin.common.filter'|trans }}
                            {% if card_filter_params %}
                                <span class="badge bg-danger ms-1">{{ card_filter_params|length }}</span>
                            {% endif %}
                        </button>
                    {% endif %}
                    {{ actions|default('') }}
                    {{ toolbar_extra|default('') }}
                </div>
            </div>
        </div>
    {% endif %}
    <div class="card-body">
        {% if card_filter_form %}
            {{ include('admin/_components/filter/_accordion_panel.html.twig', {
                form: card_filter_form,
                collapse_id: card_filter_collapse_id,
                is_open: card_filter_params ? true : false,
                quick_filters: quick_filters|default('')
            }) }}
        {% endif %}

        {% if before_table|default('')|trim %}
            {{ before_table|raw }}
        {% endif %}

        {% if is_empty %}
            {{ include('admin/_components/_empty_state.html.twig', {
                title: empty_state_title|default('admin.common.no_records'|trans),
                text: empty_state_text|default('')
            }) }}
        {% else %}
            <div class="list-table-responsive">
                <table class="table table-hover {{ list_table ? 'document-list-table' : '' }} {{ table_class|default('') }}">
                    <thead>
                    {{ table_head }}
                    </thead>
                    <tbody>
                    {{ table_body }}
                    </tbody>
                </table>
            </div>

            {{ include('admin/_components/pagination.html.twig', {pagination: pagination}) }}
        {% endif %}

    </div>
</div>
