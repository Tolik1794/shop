{#
    Reusable sticky form action bar. Include inside the form, or pass form_id when the
    layout requires the action bar to sit outside it.

    Params:
    - cancel_url (string, required): href for the Cancel button.
    - save_and_continue (bool, default true): show the "Save and continue" submit.
    - context (string, optional): short left-side context text (e.g. entity name).
    - summary (html, optional): richer left-side summary markup (e.g. number + live totals).
    - form_id (string, optional): associate actions with a form outside this component.
#}
<div class="form-actions d-flex flex-wrap align-items-center gap-2" {{ stimulus_controller('unsaved-indicator', {formId: form_id|default('')}) }}>
    <div class="form-actions__meta d-flex flex-wrap align-items-center gap-2 me-auto">
        {% if context|default(false) %}
            <span class="text-muted small text-truncate">{{ context }}</span>
        {% endif %}
        {% if summary|default('')|trim %}
            <div class="form-actions__summary">{{ summary|raw }}</div>
        {% endif %}
        <span class="text-warning small d-none" {{ stimulus_target('unsaved-indicator', 'indicator') }}>
            <i class="fa-solid fa-circle-exclamation me-1"></i>{{ 'admin.common.unsaved_changes'|trans }}
        </span>
    </div>
    <button type="submit" class="btn btn-primary"{% if form_id|default(false) %} form="{{ form_id }}"{% endif %}>{{ 'admin.common.save'|trans }}</button>
    {% if save_and_continue|default(true) %}
        <button name="save" value="stay" type="submit" class="btn btn-primary"{% if form_id|default(false) %} form="{{ form_id }}"{% endif %}>{{ 'admin.common.save_and_continue'|trans }}</button>
    {% endif %}
    <a href="{{ cancel_url }}" class="btn btn-outline-secondary">{{ 'admin.common.cancel'|trans }}</a>
</div>
