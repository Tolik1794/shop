{% set modal_size = size|default('') %}
{% set modal_scrollable = scrollable|default(true) %}
{% set modal_dialog_class = dialog_class|default('') %}

<div class="modal fade" id="{{ modal_id }}" tabindex="-1" aria-labelledby="{{ modal_id }}-label" aria-hidden="true">
    <div class="modal-dialog{{ modal_size ? ' modal-' ~ modal_size : '' }}{{ modal_scrollable ? ' modal-dialog-scrollable' : '' }}{{ modal_dialog_class ? ' ' ~ modal_dialog_class : '' }}">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="{{ modal_id }}-label">{{ title }}</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'admin.common.close'|trans }}"></button>
            </div>
            <div class="modal-body">
                {% block modal_body %}{% endblock %}
            </div>
            {% if block('modal_footer') is defined and block('modal_footer')|trim %}
                <div class="modal-footer">
                    {{ block('modal_footer') }}
                </div>
            {% endif %}
        </div>
    </div>
</div>
