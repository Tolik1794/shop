<nav class="{{ breadcrumb_class|default('mb-3') }}" aria-label="{{ 'breadcrumb'|trans }}">
    {% for item in items %}
        {% if item.url is defined and item.url %}
            <a href="{{ item.url }}">{{ item.label|trans }}</a>
        {% else %}
            <span{% if item.dynamic|default(false) %} data-admin-breadcrumb-current{% endif %}>{{ item.label|trans }}</span>
        {% endif %}

        {% if not loop.last %}
            <span class="mx-1">&gt;</span>
        {% endif %}
    {% endfor %}
</nav>
