{% extends 'admin/_store_components/layout.html.twig' %}

{% block title %}Customer label{% endblock %}

{% block navbar_breadcrumb %}
    {{ include('admin/_components/_resource_breadcrumb.html.twig', {
        section_label: 'Customer labels',
        section_url: path('app_admin_customer_label_index', {store_id: app.request.attributes.get('store_id')}),
        current_label: entity.id ? entity.name : 'New'
    }) }}
{% endblock %}

{% block main_content %}
    <main class="content">
        <div class="container-fluid p-0">
            {{ form_start(form) }}
            <div class="row">
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title mb-0">{{ entity.id ? entity.name : 'New' }}</h5>
                    </div>
                    <div class="card-body">
                        {{ form_errors(form) }}

                        {% for name, widget in form %}
                            {{ form_row(widget) }}
                        {% endfor %}

                    </div>
                </div>
                {{ include('admin/_components/_form_actions.html.twig', {
                    cancel_url: path('app_admin_customer_label_index', app.request.query.all|merge(app.request.attributes.get('_route_params')))
                }) }}
            </div>
            {{ form_end(form, {'render_rest': false}) }}
        </div>
    </main>
{% endblock %}
