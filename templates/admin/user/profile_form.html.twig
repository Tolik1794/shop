{% extends 'admin/layout.html.twig' %}

{% block title %}Hello MainController!{% endblock %}

{% block main_content %}
    <main class="content">
        <div class="container-fluid p-0">
            <div class="row">
                <div class="col-xxl-4 col-xl-5 col-lg-6 col-md-6">
                    {{ include('admin/_components/card/_tab_card.html.twig', {
                        tab_head: [
                            include('admin/_components/tab_icon/_show.html.twig')
                        ],
                        tab_body: [
                            render(controller(
                                'App\\Controller\\Admin\\UserController::info',
                                { 'user_id': entity.userIdentifier }
                            ))
                        ]
                    }) }}
                </div>
                <div class="col-xxl-8 col-xl-7 col-lg-6 col-md-6">
                    {{ form_start(form) }}
                    <div class="card">
                        <div class="card-header">
                            <h5 class="card-title mb-0">{{ 'Private info'|trans }}</h5>
                        </div>
                        <div class="card-body">
                            {% if avatar %}
                                <img class="article-img"
                                     src="{{ avatar|trim_full_path|imagine_filter('squared_thumbnail_small') }}">
                            {% endif %}
                            {{ form_errors(form) }}

                            {{ include('admin/_components/_form_widgets.html.twig', {form: form}) }}

                        </div>
                    </div>
                    {{ include('admin/_components/_form_actions.html.twig', {
                        cancel_url: path('admin_user_profile'),
                        save_and_continue: false
                    }) }}
                    {{ form_end(form, {'render_rest': false}) }}
                </div>
            </div>
        </div>
    </main>
{% endblock %}
