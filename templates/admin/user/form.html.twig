{% extends 'admin/layout.html.twig' %}

{% block title %}Hello MainController!{% endblock %}

{% block main_content %}
    <main class="content">
        <div class="container-fluid p-0">
            {{ form_start(form) }}
            <div class="row">
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title mb-0">{{ 'Private info'|trans }}</h5>
                    </div>
                    <div class="card-body">
                        {% if avatar %}
                            <img alt="Avatar"
                                 class="article-img"
                                 src="{{ avatar|trim_full_path|imagine_filter('squared_thumbnail_small') }}">
                        {% endif %}

                        <div class="form-control-lg">
                            {{ form_errors(form) }}

                            {{ include('admin/_components/_form_widgets.html.twig', {form: form}) }}

                        </div>
                    </div>
                </div>
                {{ include('admin/_components/_form_actions.html.twig', {
                    cancel_url: path('admin_user_index', app.request.query.all|merge(app.request.attributes.get('_route_params')))
                }) }}
            </div>
            {{ form_end(form, {'render_rest': false}) }}
        </div>
    </main>
{% endblock %}
