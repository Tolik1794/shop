{% extends 'admin/layout.html.twig' %}

{% block title %}User list{% endblock %}

{% block navbar_breadcrumb %}
    {{ include('admin/_components/_resource_breadcrumb.html.twig', {
        section_label: 'Managers',
        section_url: path('admin_user_index'),
        current_label: first_entity ? first_entity.email : ''
    }) }}
{% endblock %}

{% set table_actions %}{% endset %}

{% set table_head %}
    <tr>
        <th>{{ 'Email'|trans }}</th>
        <th>{{ 'Nickname'|trans }}</th>
        <th>{{ 'Groups'|trans }}</th>
    </tr>
{% endset %}

{% set table_body %}
    {% for entity in pagination %}
        <tr
                id="{{ entity.nickname }}"
                data-id-column="user_id"
                class="{{ entity.nickname == first_entity.nickname ? 'table-active' : '' }}"
                data-action="click->reload-card#reloadCard click->reload-card#tableActivate"
                data-link="{{ path('admin_user_show', {user_id: entity.nickname}) }}"
                data-breadcrumb-label="{{ entity.email }}"
                onclick="document.getElementById('first-tab').click()"
        >
            <td>{{ entity.email }}</td>
            <td>{{ entity.nickname }}</td>
            <td>
                {% for group in entity.groups %}
                    <span class="badge bg-light text-dark">{{ group.name }}</span>
                {% else %}
                    <span class="text-muted">{{ 'No groups'|trans }}</span>
                {% endfor %}
            </td>
        </tr>
    {% endfor %}
{% endset %}

{% block main_content %}
    <main class="content" {{ stimulus_controller('reload-card') }}>
        <div class="container-fluid p-0">
            <div class="row">
                <div class="col-xxl-5 col-xl-5 col-lg-6">
                    {{ include('admin/_components/card/_tab_card.html.twig', {
                        tab_head: [
                            include('admin/_components/tab_icon/_show.html.twig'),
                        ],
                        tab_body: [
                            first_entity ? render(controller(
                                'App\\Controller\\Admin\\UserController::show',
                                { 'user_id': first_entity.nickname, 'request': app.request }
                            )) : '<div class="card"><div class="card-body">' ~ 'Nothing to show...'|trans ~ '</div></div>',
                        ]
                    }) }}
                </div>
                <div class="col-xxl-7 col-xl-7 col-lg-6">
                    {{ include('admin/_components/card/_table_card.html.twig', {
                        actions: table_actions,
                        table_title: 'Managers',
                        table_head: table_head,
                        table_body: table_body,
                        filter_form: filter_form
                    }) }}
                </div>
            </div>
        </div>
    </main>
{% endblock %}
