{% set actions %}
    <a class="btn btn-light btn-sm" href="{{ path('app_admin_warehouse_edit', query_params|merge({store_id: app.request.attributes.get('store_id'), id: entity.id})) }}"><i class="fa-solid fa-pen me-1"></i>Edit</a>
    <a class="btn btn-light btn-sm" href="{{ path('app_admin_warehouse_stock_index', {store_id: app.request.attributes.get('store_id'), warehouse_id: entity.id}) }}"><i class="fa-solid fa-boxes-stacked me-1"></i>Stock</a>
{% endset %}

<div class="card" {{ stimulus_target('reload-card', 'card') }} data-card-id="{{ entity.id }}">
    <div class="card-header">
        {% if actions|trim %}
            {{ include('admin/_components/card/_actions.html.twig', {actions: actions}) }}
        {% endif %}
        <h5 class="card-title mb-0">{{ entity.name }}</h5>
    </div>
    <div class="card-body">
        <div class="row g-0">
            <div class="col-sm-9 col-xl-12 col-xxl-9">
                <strong>Name</strong>
                <p>{{ entity.name }}</p>
            </div>
        </div>

        <table class="table table-sm mt-2 mb-4">
            <tbody>
            <tr>
                <th>Store</th>
                <td>{{ entity.store }}</td>
            </tr>
            <tr>
                <th>Stock</th>
                <td>
                    <a href="{{ path('app_admin_warehouse_stock_index', {store_id: app.request.attributes.get('store_id'), warehouse_id: entity.id}) }}">Open</a>
                </td>
            </tr>
            </tbody>
        </table>
    </div>
</div>
