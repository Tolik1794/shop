{% extends 'admin/_store_components/layout.html.twig' %}

{% block title %}New production order{% endblock %}

{% block main_content %}
	<main class="content" {{ stimulus_controller('select-two') }}>
		<div class="container-fluid p-0">
			<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
				<div>
					<h1 class="h3 mb-1">New production order</h1>
				</div>
				<div class="d-flex flex-wrap gap-2">
					<button form="production-order-create-form" type="submit" class="btn btn-primary">Create</button>
					<button form="production-order-create-form" name="save" value="stay" type="submit" class="btn btn-outline-primary">Create and continue</button>
					<a href="{{ path('app_admin_production_order_index', {store_id: app.request.attributes.get('store_id')}) }}" class="btn btn-light">Cancel</a>
				</div>
			</div>

			<div class="card">
				<div class="card-header">
					<h5 class="card-title mb-0">Create from recipe</h5>
				</div>
				<div class="card-body">
					{{ form_start(form, {attr: {id: 'production-order-create-form', 'data-select-two-target': 'form'}}) }}
						{{ form_errors(form) }}
						{{ form_row(form.recipe) }}
						{{ form_row(form.warehouse) }}
						{{ form_row(form.plannedQuantity) }}
						{{ form_row(form.plannedStartAt) }}
						{{ form_row(form.plannedEndAt) }}
						{{ form_row(form.comment) }}
						{{ form_widget(form._token) }}
					{{ form_end(form, {'render_rest': false}) }}
				</div>
			</div>
		</div>
	</main>
{% endblock %}
