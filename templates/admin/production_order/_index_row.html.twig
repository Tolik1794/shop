<tr
		id="{{ entity.id }}"
		data-id-column="id"
		class="{{ first_entity and entity.id == first_entity.id ? 'table-active' : '' }}"
		data-action="click->reload-card#reloadDocumentCards click->reload-card#tableActivate"
		data-show-link="{{ path('app_admin_production_order_show', {store_id: app.request.attributes.get('store_id'), id: entity.id}) }}"
		data-history-link="{{ path('app_admin_production_order_history', {store_id: app.request.attributes.get('store_id'), id: entity.id}) }}"
		data-breadcrumb-label="#{{ entity.id }}"
>
	<td>
		<table class="table table-sm mb-2">
			<thead>
			<tr>
				<th>ID</th>
				<th>{{ 'Product'|trans }}</th>
				<th>{{ 'Status'|trans }}</th>
				<th>{{ 'Planned'|trans }}</th>
				<th>{{ 'Completed'|trans }}</th>
				<th>{{ 'Warehouse'|trans }}</th>
			</tr>
			</thead>
			<tbody>
			<tr>
				<td><strong>#{{ entity.id }}</strong></td>
				<td><strong>{{ entity.product.name }}</strong></td>
				<td>{{ entity.status.value }}</td>
				<td>{{ entity.plannedQuantity|quantity(entity.product) }}</td>
				<td>{{ entity.completedQuantity|quantity(entity.product) }}</td>
				<td>{{ entity.warehouse ? entity.warehouse.name : '' }}</td>
			</tr>
			</tbody>
		</table>

		{% if entity.materials|length > 0 %}
			<table class="table table-sm mb-0">
				<thead>
				<tr>
					<th>{{ 'Material'|trans }}</th>
					<th>{{ 'Code'|trans }}</th>
					<th>{{ 'Planned qty'|trans }}</th>
					<th>{{ 'Waste %'|trans }}</th>
					<th>{{ 'Comment'|trans }}</th>
				</tr>
				</thead>
				<tbody>
				{% for material in entity.materials %}
					<tr>
						<td><strong>{{ material.material.name }}</strong></td>
						<td>{{ material.material.code }}</td>
						<td>{{ material.plannedQuantity|quantity(material.material) }}</td>
						<td>{{ material.wastePercent }}</td>
						<td>{{ material.comment }}</td>
					</tr>
				{% endfor %}
				</tbody>
			</table>
		{% else %}
			<span class="text-muted small">{{ 'No materials'|trans }}</span>
		{% endif %}
	</td>
</tr>
