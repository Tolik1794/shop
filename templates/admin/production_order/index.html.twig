{% extends 'admin/_store_components/layout.html.twig' %}

{% block title %}Production orders{% endblock %}

{% set table_actions %}
	<a class="btn btn-light btn-sm" href="{{ path('app_admin_production_order_new', {store_id: app.request.attributes.get('store_id')}) }}"><i class="fa-solid fa-plus me-1"></i>New</a>
	<a class="btn btn-light btn-sm" href="{{ path('app_admin_production_recipe_index', {store_id: app.request.attributes.get('store_id')}) }}"><i class="fa-solid fa-list-check me-1"></i>Recipes</a>
{% endset %}

{% set table_head %}
{% endset %}

{% set table_body %}
	{% for entity in pagination %}
		{{ include('admin/production_order/_index_row.html.twig', {entity: entity, first_entity: first_entity}) }}
	{% endfor %}
{% endset %}

{% block main_content %}
	<main class="content" {{ stimulus_controller('reload-card') }}>
		<div class="container-fluid p-0">
			{{ include('admin/_components/_quick_action_flashes.html.twig') }}

			<div class="row">
				<div class="col-xxl-4 col-xl-5 col-lg-6">
					{{ include('admin/_components/card/_tab_card.html.twig', {
						tab_head: [include('admin/_components/tab_icon/_show.html.twig')],
						tab_body: [
							first_entity ? render(controller(
								'App\\Controller\\Admin\\ProductionOrderController::show',
								{ store_id: app.request.attributes.get('store_id'), id: first_entity.id, 'request': app.request }
							)) : '<div class="card"><div class="card-body">Nothing to show...</div></div>'
						]
					}) }}
				</div>
				<div class="col-xxl-8 col-xl-7 col-lg-6">
					{{ include('admin/_components/card/_table_card.html.twig', {
						actions: table_actions,
						table_title: 'Production orders',
						table_head: table_head,
						table_body: table_body
					}) }}
				</div>
			</div>
		</div>
	</main>
{% endblock %}
