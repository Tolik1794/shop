{% extends 'admin/_store_components/layout.html.twig' %}

{% block title %}Inventory reasons{% endblock %}

{% block navbar_breadcrumb %}
    {% set page_breadcrumb %}
    {{ include('admin/_components/_resource_breadcrumb.html.twig', {
        section_label: 'Inventory reasons',
        section_url: path('app_admin_inventory_reason_index', {store_id: app.request.attributes.get('store_id')}),
        current_label: first_entity ? first_entity.name : ''
    }) }}
    {% endset %}
    {{ include('admin/_components/_navbar_header.html.twig', {title: 'Inventory reasons'|trans, breadcrumb: page_breadcrumb}) }}
{% endblock %}

{% set table_actions %}
    {% if is_granted('inventory_reason.manage') %}
        <a class="btn btn-light btn-sm" href="{{ path('app_admin_inventory_reason_new', {store_id: app.request.attributes.get('store_id')}) }}"><i class="fa-solid fa-plus me-1"></i>{{ 'New'|trans }}</a>
    {% endif %}
{% endset %}

{% set table_head %}
    <tr>
        <th>{{ 'Name'|trans }}</th>
        <th>{{ 'Type'|trans }}</th>
        <th>{{ 'Status'|trans }}</th>
    </tr>
{% endset %}

{% set table_body %}
    {% for entity in pagination %}
        <tr
                id="{{ entity.id }}"
                data-id-column="id"
                class="{{ first_entity and entity.id == first_entity.id ? 'table-active' : '' }}"
                data-action="click->reload-card#reloadCard click->reload-card#tableActivate"
                data-link="{{ path('app_admin_inventory_reason_show', {store_id: app.request.attributes.get('store_id'), id: entity.id}) }}"
                data-breadcrumb-label="{{ entity.name }}"
                onclick="document.getElementById('first-tab').click()"
        >
            <td>{{ entity.name }}</td>
            <td>{{ entity.type.value }}</td>
            <td>{{ entity.status.value }}</td>
        </tr>
    {% endfor %}
{% endset %}

{% block main_content %}
    <main class="content" {{ stimulus_controller('reload-card') }}>
        <div class="container-fluid p-0">
            <div class="row">
                <div class="col-12 col-xl-5 col-lg-5">
                    {{ include('admin/_components/card/_tab_card.html.twig', {
                        tab_head: [
                            include('admin/_components/tab_icon/_show.html.twig'),
                        ],
                        tab_body: [
                            first_entity ? render(controller(
                                'App\\Controller\\Admin\\InventoryReasonController::show',
                                { store_id: app.request.attributes.get('store_id'), id: first_entity.id, 'request': app.request }
                            )) : '<div class="card"><div class="card-body">' ~ 'Nothing to show...'|trans ~ '</div></div>',
                        ]
                    }) }}
                </div>
                <div class="col-12 col-xl-7 col-lg-7 order-first">
                    {{ include('admin/_components/card/_table_card.html.twig', {
                        actions: table_actions,
                        table_title: 'Inventory reasons',
                        table_head: table_head,
                        table_body: table_body,
                        filter_form: filter_form
                    }) }}
                </div>
            </div>
        </div>
    </main>
{% endblock %}
