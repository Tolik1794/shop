{% set actions %}
    <a class="btn btn-light btn-sm" href="{{ path('app_admin_customer_edit', query_params|merge({store_id: app.request.attributes.get('store_id'), id: entity.id})) }}"><i class="fa-solid fa-pen me-1"></i>Edit</a>
{% endset %}

<div class="card" {{ stimulus_target('reload-card', 'card') }} data-card-id="{{ entity.id }}">
    <div class="card-header">
        {% if actions|trim %}
            {{ include('admin/_components/card/_actions.html.twig', {actions: actions}) }}
        {% endif %}
        <h5 class="card-title mb-0">{{ entity.fullName }}</h5>
    </div>
    <div class="card-body">
        <table class="table table-sm mt-2 mb-4">
            <tbody>
            <tr>
                <th>{{ 'First name'|trans }}</th>
                <td>{{ entity.name }}</td>
            </tr>
            <tr>
                <th>{{ 'Last name'|trans }}</th>
                <td>{{ entity.lastName }}</td>
            </tr>
            <tr>
                <th>{{ 'Phone'|trans }}</th>
                <td>{{ entity.phone }}</td>
            </tr>
            <tr>
                <th>{{ 'Email'|trans }}</th>
                <td>{{ entity.email }}</td>
            </tr>
            <tr>
                <th>{{ 'Status'|trans }}</th>
                <td>{{ entity.status.value }}</td>
            </tr>
            <tr>
                <th>Comment</th>
                <td>{{ entity.comment }}</td>
            </tr>
            </tbody>
        </table>

        <p class="text-muted small mb-2">Archived customers are hidden from new operations, but historical documents remain readable.</p>
        <form method="post" action="{{ path('app_admin_customer_delete', {store_id: app.request.attributes.get('store_id'), id: entity.id}) }}" onsubmit="return confirm('Archive customer? Historical documents will remain readable.');">
            <input type="hidden" name="_token" value="{{ csrf_token('delete_customer_' ~ entity.id) }}">
            <button class="btn btn-danger btn-sm" type="submit">Archive</button>
        </form>
    </div>
</div>
