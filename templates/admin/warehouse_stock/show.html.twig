{% set actions %}
    <a class="btn btn-light btn-sm" href="{{ path('app_admin_warehouse_stock_edit', query_params|merge({store_id: app.request.attributes.get('store_id'), id: entity.id, warehouse_id: entity.warehouse.id})) }}"><i class="fa-solid fa-pen me-1"></i>{{ 'Edit'|trans }}</a>
{% endset %}

<div class="card" {{ stimulus_target('reload-card', 'card') }} data-card-id="{{ entity.id }}">
    <div class="card-header">
        {% if actions|trim %}
            {{ include('admin/_components/card/_actions.html.twig', {actions: actions}) }}
        {% endif %}
        <h5 class="card-title mb-0">{{ entity.product.name }}</h5>
    </div>
    <div class="card-body">
        <div class="row g-0">
            <div class="col-sm-9 col-xl-12 col-xxl-9">
                <strong>{{ 'Product'|trans }}</strong>
                <p>{{ entity.product.name }}</p>
            </div>
        </div>

        <table class="table table-sm mt-2 mb-4">
            <tbody>
            <tr>
                <th>{{ 'Code'|trans }}</th>
                <td>{{ entity.product.code }}</td>
            </tr>
            <tr>
                <th>{{ 'Warehouse'|trans }}</th>
                <td>{{ entity.warehouse.name }}</td>
            </tr>
            <tr>
                <th>{{ 'Average cost'|trans }}</th>
                <td>{{ entity.averageCost|money }}</td>
            </tr>
            <tr>
                <th>{{ 'Quantity on hand'|trans }}</th>
                <td>{{ entity.quantityOnHand|quantity(entity.product) }}</td>
            </tr>
            <tr>
                <th>{{ 'Reserved quantity'|trans }}</th>
                <td>{{ entity.reservedQuantity|quantity(entity.product) }}</td>
            </tr>
            </tbody>
        </table>

        <h6 class="mb-2">{{ 'Batches'|trans }}</h6>
        {% if batches|length > 0 %}
            <div class="table-responsive">
                <table class="table table-sm mb-0">
                    <thead>
                    <tr>
                        <th>{{ 'Received'|trans }}</th>
                        <th>{{ 'Initial'|trans }}</th>
                        <th>{{ 'Remaining'|trans }}</th>
                        <th>{{ 'Unit cost'|trans }}</th>
                        <th>{{ 'Sale price'|trans }}</th>
                        <th>{{ 'Purchase entry'|trans }}</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for batch in batches %}
                        <tr>
                            <td>{{ batch.receivedAt ? batch.receivedAt|date('Y-m-d H:i') : '' }}</td>
                            <td>{{ batch.initialQuantity|quantity(entity.product) }}</td>
                            <td>{{ batch.remainingQuantity|quantity(entity.product) }}</td>
                            <td>{{ batch.unitCost|money }}</td>
                            <td>{{ batch.salePrice|money }}</td>
                            <td>{{ batch.purchaseEntry ? batch.purchaseEntry.id : '' }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <p class="text-muted mb-0">{{ 'No batches.'|trans }}</p>
        {% endif %}
    </div>
</div>
