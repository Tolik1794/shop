{% extends 'admin/_store_components/layout.html.twig' %}

{% block title %}Warehouse stock{% endblock %}

{% block navbar_breadcrumb %}
    {{ include('admin/_components/_breadcrumb.html.twig', {
        breadcrumb_class: 'mb-0',
        items: [
            {
                label: 'Warehouses',
                url: path('app_admin_warehouse_index', {store_id: app.request.attributes.get('store_id')})
            },
            {
                label: warehouse.name,
                url: path('app_admin_warehouse_index', {store_id: app.request.attributes.get('store_id'), id: warehouse.id, page: warehouse_index_page})
            },
            {
                label: 'Stock'
            }
        ]
    }) }}
{% endblock %}

{% set table_actions %}
    {% if is_granted('warehouse_stock.manage') %}
        <a class="btn btn-light btn-sm" href="{{ path('app_admin_warehouse_stock_new', {store_id: app.request.attributes.get('store_id'), warehouse_id: warehouse.id}) }}"><i class="fa-solid fa-plus me-1"></i>{{ 'New'|trans }}</a>
    {% endif %}
{% endset %}

{% set table_head %}
    <tr>
        <th>{{ 'Product'|trans }}</th>
        <th>{{ 'Code'|trans }}</th>
        <th>{{ 'Quantity'|trans }}</th>
    </tr>
{% endset %}

{% set table_body %}
    {% for entity in pagination %}
        <tr
                id="{{ entity.id }}"
                data-id-column="id"
                class="{{ first_entity and entity.id == first_entity.id ? 'table-active' : '' }}"
                data-action="click->reload-card#reloadCard click->reload-card#tableActivate"
                data-link="{{ path('app_admin_warehouse_stock_show', {store_id: app.request.attributes.get('store_id'), warehouse_id: warehouse.id, id: entity.id}) }}"
                onclick="document.getElementById('first-tab').click()"
        >
            <td>{{ entity.product.name }}</td>
            <td>{{ entity.product.code }}</td>
            <td>{{ entity.quantityOnHand|quantity(entity.product) }}</td>
        </tr>
    {% endfor %}
{% endset %}

{% block main_content %}
    <main class="content" {{ stimulus_controller('reload-card') }}>
        <div class="container-fluid p-0">
            <div class="row">
                <div class="col-xxl-4 col-xl-5 col-lg-6">
                    {{ include('admin/_components/card/_tab_card.html.twig', {
                        tab_search_key: 1,
                        tab_head: [
                            include('admin/_components/tab_icon/_show.html.twig'),
                            include('admin/_components/tab_icon/_filter.html.twig')
                            ~ (app.request.query.all(filter_form.vars.name) ? '<span style="color: red">*</span>' : '')
                        ],
                        tab_body: [
                            first_entity ? render(controller(
                                'App\\Controller\\Admin\\WarehouseStockController::show',
                                { store_id: app.request.attributes.get('store_id'), warehouse_id: warehouse.id, id: first_entity.id, 'request': app.request }
                            )) : '<div class="card"><div class="card-body">' ~ 'Nothing to show...'|trans ~ '</div></div>',
                            include('admin/_components/card/_filter_card.html.twig', {form: filter_form})
                        ]
                    }) }}
                </div>
                <div class="col-xxl-8 col-xl-7 col-lg-6">
                    {{ include('admin/_components/card/_table_card.html.twig', {
                        actions: table_actions,
                        table_title: 'Warehouse stock',
                        table_head: table_head,
                        table_body: table_body
                    }) }}
                </div>
            </div>
        </div>
    </main>
{% endblock %}
