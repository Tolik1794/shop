{% extends 'admin/layout.html.twig' %}

{% block title %}{{ 'admin.tax_income.title.new'|trans }}{% endblock %}

{% block navbar_breadcrumb %}
    {% set page_breadcrumb %}
        {{ include('admin/_components/_resource_breadcrumb.html.twig', {
            section_label: 'admin.tax_income.title.list'|trans,
            section_url: path('admin_tax_income_index'),
            current_label: 'admin.common.new'|trans
        }) }}
    {% endset %}
    {{ include('admin/_components/_navbar_header.html.twig', {
        title: 'admin.tax_income.title.new'|trans,
        breadcrumb: page_breadcrumb
    }) }}
{% endblock %}

{% block main_content %}
    <main class="content">
        <div class="container-fluid p-0">
            {{ form_start(form) }}
            <div class="row">
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title mb-0">{{ 'admin.tax_income.title.new'|trans }}</h5>
                    </div>
                    <div class="card-body">
                        {{ form_errors(form) }}
                        {{ include('admin/_components/_form_widgets.html.twig', {form: form}) }}
                        <p class="text-muted small mb-0">{{ 'admin.tax_income.manual_hint'|trans }}</p>
                    </div>
                </div>
                {{ include('admin/_components/_form_actions.html.twig', {
                    cancel_url: path('admin_tax_income_index')
                }) }}
            </div>
            {{ form_end(form, {'render_rest': false}) }}
        </div>
    </main>
{% endblock %}
