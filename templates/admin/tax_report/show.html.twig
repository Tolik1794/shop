{% extends 'admin/layout.html.twig' %}

{% block title %}{{ 'admin.tax_report.title.show'|trans }}{% endblock %}

{% block navbar_breadcrumb %}
    {% set page_breadcrumb %}
        {{ include('admin/_components/_resource_breadcrumb.html.twig', {
            section_label: 'admin.tax_report.title.list'|trans,
            section_url: path('admin_tax_report_index', {entity: draft.legalEntity.id, year: draft.period.dateFrom|date('Y')}),
            current_label: draft.payload.meta.period_label|default('admin.tax_report.title.show'|trans)
        }) }}
    {% endset %}
    {{ include('admin/_components/_navbar_header.html.twig', {
        title: 'admin.tax_report.title.show'|trans,
        breadcrumb: page_breadcrumb
    }) }}
{% endblock %}

{% block main_content %}
    <main class="content">
        <div class="container-fluid p-0">

            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center pb-2">
                    <div>
                        <h5 class="card-title mb-0">{{ draft.legalEntity }}</h5>
                        <div class="text-muted small">
                            {{ draft.payload.meta.period_label|default('') }}
                            &middot; {{ 'admin.tax_report.fields.generated_at'|trans }}: {{ draft.generatedAt|date('d.m.Y H:i') }}
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <a class="btn btn-primary btn-sm" href="{{ path('admin_tax_report_print', {id: draft.id}) }}" target="_blank">
                            <i class="fa-solid fa-print me-1"></i>{{ 'admin.tax_report.actions.print'|trans }}
                        </a>
                    </div>
                </div>
                <div class="card-body pt-2">
                    <div class="text-muted small mb-2">
                        <i class="fa-solid fa-file-lines me-1"></i>{{ 'admin.tax_report.fields.form_version'|trans }}: {{ draft.formVersion }}
                    </div>
                    <div class="alert alert-warning py-2 small mb-0">
                        <i class="fa-solid fa-triangle-exclamation me-1"></i>{{ 'admin.tax_report.draft_warning'|trans }}
                    </div>
                </div>
            </div>

            <form method="post" action="{{ path('admin_tax_report_update', {id: draft.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('update_tax_report_' ~ draft.id) }}">
                <div class="card">
                    <div class="card-header pb-0">
                        <h5 class="card-title mb-0">{{ 'admin.tax_report.title.fields'|trans }}</h5>
                    </div>
                    <div class="table-responsive">
                        <table class="table mb-0 align-middle">
                            <thead>
                            <tr>
                                <th style="width:40%">{{ 'admin.tax_report.fields.field'|trans }}</th>
                                <th style="width:25%">{{ 'admin.tax_report.fields.value'|trans }}</th>
                                <th style="width:20%">{{ 'admin.tax_report.fields.calculated'|trans }}</th>
                                <th>{{ 'admin.tax_report.fields.source'|trans }}</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for key, field in draft.payload.fields %}
                                <tr>
                                    <td>{{ ('admin.tax_report.field.' ~ key)|trans }}</td>
                                    <td>
                                        <input type="text" class="form-control form-control-sm{{ field.source == 'manual' ? ' border-warning' : '' }}"
                                               name="fields[{{ key }}]" value="{{ field.value }}">
                                    </td>
                                    <td class="text-muted small">{{ field.calculated }}</td>
                                    <td>
                                        {% if field.source == 'manual' %}
                                            <span class="badge bg-warning text-dark">{{ 'admin.tax_report.source.manual'|trans }}</span>
                                        {% else %}
                                            <span class="badge bg-light text-dark">{{ 'admin.tax_report.source.calculated'|trans }}</span>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    <div class="card-footer d-flex justify-content-between align-items-center">
                        <span class="text-muted small">{{ 'admin.tax_report.manual_hint'|trans }}</span>
                        <button class="btn btn-primary btn-sm" type="submit">{{ 'admin.common.save'|trans }}</button>
                    </div>
                </div>
            </form>

            <div class="mt-3 text-muted small">
                <i class="fa-solid fa-circle-info me-1"></i>{{ 'admin.legal_entity.disclaimer'|trans }}
            </div>
        </div>
    </main>
{% endblock %}
