{% set actions %}
    <a class="dropdown-item" href="{{ path('app_admin_product_price_edit', {store_id: app.request.attributes.get('store_id'), product_id: entity.product.id, id: entity.id}) }}">Edit</a>
{% endset %}

<div class="card" {{ stimulus_target('reload-card', 'card') }} data-card-id="{{ entity.id }}">
    <div class="card-header">
        {% if actions|trim %}
            {{ include('admin/_components/card/_actions.html.twig', {actions: actions}) }}
        {% endif %}
        <h5 class="card-title mb-0">{{ entity.type.value }} price</h5>
    </div>
    <div class="card-body">
        <table class="table table-sm mt-2 mb-4">
            <tbody>
            <tr>
                <th>Product</th>
                <td>{{ entity.product.name }}</td>
            </tr>
            <tr>
                <th>Type</th>
                <td>{{ entity.type.value }}</td>
            </tr>
            <tr>
                <th>Price</th>
                <td>{{ entity.price }}</td>
            </tr>
            <tr>
                <th>Currency</th>
                <td>{{ entity.currency.code }}</td>
            </tr>
            <tr>
                <th>Base price</th>
                <td>{{ entity.priceBase }}</td>
            </tr>
            <tr>
                <th>Valid from</th>
                <td>{{ entity.validFrom|date('Y-m-d H:i') }}</td>
            </tr>
            <tr>
                <th>Valid to</th>
                <td>{{ entity.validTo ? entity.validTo|date('Y-m-d H:i') : '' }}</td>
            </tr>
            <tr>
                <th>Comment</th>
                <td>{{ entity.comment }}</td>
            </tr>
            </tbody>
        </table>
    </div>
</div>
