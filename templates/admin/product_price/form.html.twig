{% extends 'admin/_store_components/layout.html.twig' %}

{% block title %}Product price{% endblock %}

{% block navbar_breadcrumb %}
    {{ include('admin/_components/_breadcrumb.html.twig', {
        breadcrumb_class: 'mb-0',
        items: [
            {
                label: 'Products',
                url: path('admin_product_index', {store_id: app.request.attributes.get('store_id')})
            },
            {
                label: product.name,
                url: path('admin_product_index', {store_id: app.request.attributes.get('store_id'), id: product.id, page: product_index_page})
            },
            {
                label: 'Prices',
                url: entity.id
                    ? path('app_admin_product_price_index', {store_id: app.request.attributes.get('store_id'), product_id: product.id, id: entity.id, page: product_price_index_page})
                    : path('app_admin_product_price_index', {store_id: app.request.attributes.get('store_id'), product_id: product.id})
            },
            {
                label: entity.id ? entity.type.value : 'New'
            }
        ]
    }) }}
{% endblock %}

{% block main_content %}
    <main class="content">
        <div class="container-fluid p-0">
            {{ form_start(form) }}
            <div class="row">
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title mb-0">{{ entity.id ? entity.type.value : 'New' }}</h5>
                    </div>
                    <div class="card-body">
                        {% if form.vars.errors|length > 0 %}
                            <div class="form-error">
                                {{ form_errors(form) }}
                            </div>
                        {% endif %}

                        {% for name, widget in form %}
                            {{ form_row(widget) }}
                        {% endfor %}

                    </div>
                </div>
                {{ include('admin/_components/_form_actions.html.twig', {
                    cancel_url: path('app_admin_product_price_index', {store_id: app.request.attributes.get('store_id'), product_id: product.id})
                }) }}
            </div>
            {{ form_end(form, {'render_rest': false}) }}
        </div>
    </main>
{% endblock %}
